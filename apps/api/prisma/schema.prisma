// ==================== VEHICLES ====================

model Vehicle {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          String // body type e.g., Tent, Ref
  plate         String // license plate
  model         String // model details
  trailerNumber String? // optional trailer plate
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Фаза 3: транспорт как актив. Пока НЕ используется существующей логикой —
  // заполняется бэкфиллом (связь водитель↔машина реальной ссылкой вместо копирования).
  vin            String? // задел под глобальную идентичность актива
  ownerPersonId  String? // владелец-физлицо (частный перевозчик), если машина не компании
  ownerPerson    Person? @relation("PersonOwnedVehicles", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  driverPersonId String? // текущий водитель (реальная ссылка, а не копия полей в User)
  driverPerson   Person? @relation("PersonOperatedVehicles", fields: [driverPersonId], references: [id], onDelete: SetNull)

  orders Order[]

  @@index([companyId])
  @@index([ownerPersonId])
  @@index([driverPersonId])
}

// ==================== БУХГАЛТЕРСКОЕ ДОКУМЕНТНОЕ ЯДРО ====================
//
// Единственный контур счетов и актов. Прежний журнал (модель Invoice) убран:
// им не пользовались ни из интерфейса, ни из мобильного, а три оставшиеся в нём
// записи владелец опознал как пробные.
enum AccountingDocumentType {
  PAYMENT_INVOICE // Счёт на оплату
  SERVICE_ACT // Акт выполненных работ (оказанных услуг), включая Р-1
  RECONCILIATION_ACT // Акт сверки взаимных расчётов
  CORRECTION // Корректировочный документ
}

enum AccountingDocumentDirection {
  INCOMING
  OUTGOING
}

enum AccountingDocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AccountingDocumentLinkType {
  BASED_ON
  CORRECTS
  REPLACES
  RECONCILES
}

enum AccountingVatTreatment {
  WITHOUT_VAT // Без НДС
  STANDARD // Обычная ставка (например, 12% или 16%)
  ZERO // Нулевая ставка НДС
  EXEMPT // Освобождённый оборот
}

enum AccountingVatCalculation {
  INCLUDED // НДС уже включён в введённую цену
  EXCLUDED // НДС начисляется сверху введённой цены
}

model AccountingDocument {
  id               String                      @id @default(cuid())
  companyId        String
  company          Company                     @relation("AccountingDocumentCompany", fields: [companyId], references: [id], onDelete: Cascade)
  counterpartyId   String
  counterparty     Company                     @relation("AccountingDocumentCounterparty", fields: [counterpartyId], references: [id], onDelete: Restrict)
  type             AccountingDocumentType
  direction        AccountingDocumentDirection
  status           AccountingDocumentStatus    @default(DRAFT)
  number           String
  externalNumber   String?
  externalDate     DateTime?                   @db.Date
  documentDate     DateTime                    @db.Date
  operationDate    DateTime?                   @db.Date
  dueDate          DateTime?                   @db.Date
  reportPeriodFrom DateTime?                   @db.Date
  reportPeriodTo   DateTime?                   @db.Date
  contractId       String?
  contract         Contract?                   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  // Расчётный счёт организации, с которого выставлен документ. Его реквизиты
  // попадают в issuerSnapshot и печатаются; сама ссылка нужна для отбора и
  // для подстановки счёта по умолчанию в следующих документах.
  bankAccountId    String?
  bankAccount      FinanceAccount?             @relation("AccountingDocumentBankAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)

  /// Счёт выставлен контрагентом по публичной ссылке на отчёт.
  ///
  /// Нужно, чтобы отличить его от черновика, который завёл наш бухгалтер
  /// руками. Отозвать свой счёт контрагент вправе, чужой — нет, а по
  /// одному лишь совпадению контрагента и статуса эти два случая
  /// неразличимы.
  sharedReportLinkId String?
  sharedReportLink   SharedReportLink? @relation("SharedReportInvoices", fields: [sharedReportLinkId], references: [id], onDelete: SetNull)

  currency         String                      @default("KZT") @db.VarChar(3)

  /// Курс валюты документа к учётной валюте — ЗАФИКСИРОВАННЫЙ.
  ///
  /// Главное правило валютного учёта: курс, по которому провели документ,
  /// не меняется никогда. Завтра доллар другой — вчерашний счёт обязан
  /// остаться вчерашним, иначе отчёт за прошлый месяц завтра покажет другие
  /// цифры сам по себе. Поэтому курс не вычисляется при показе, а лежит
  /// внутри документа вместе с датой, на которую он взят.
  exchangeRate               Decimal?  @db.Decimal(18, 6)
  exchangeRateDate           DateTime? @db.Date
  /// Итог документа в учётной валюте по этому курсу — для отчётов.
  totalBase                  Decimal?  @db.Decimal(20, 2)
  subtotal                   Decimal   @default(0) @db.Decimal(20, 2)
  discountTotal              Decimal   @default(0) @db.Decimal(20, 2)
  vatTotal                   Decimal   @default(0) @db.Decimal(20, 2)
  total                      Decimal   @default(0) @db.Decimal(20, 2)
  amountPaid                 Decimal   @default(0) @db.Decimal(20, 2)
  balanceDue                 Decimal   @default(0) @db.Decimal(20, 2)
  openingBalance             Decimal?  @db.Decimal(20, 2)
  debitTurnover              Decimal?  @db.Decimal(20, 2)
  creditTurnover             Decimal?  @db.Decimal(20, 2)
  closingBalance             Decimal?  @db.Decimal(20, 2)
  issuerSnapshot             Json
  recipientSnapshot          Json
  issuerSignatorySnapshot    Json?
  recipientSignatorySnapshot Json?
  basisSnapshot              Json?
  paymentPurposeCode         String?
  paymentTerms               String?
  customerMaterialsInfo      String?
  appendixInfo               String?
  note                       String?
  version                    Int       @default(1)
  checksum                   String?   @db.VarChar(64)

  // Публичная ссылка на документ для контрагента.
  // Токен можно перевыпустить — тогда все ранее разосланные ссылки
  // перестают работать (у старой модели Invoice отзыв был невозможен).
  shareToken          String                         @unique @default(uuid())
  shareRevokedAt      DateTime?
  pdfFileUrl          String?
  pdfGeneratedAt      DateTime?
  createdById         String
  createdBy           User                           @relation("AccountingDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedById          String?
  postedBy            User?                          @relation("AccountingDocumentPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  postedAt            DateTime?
  cancelledById       String?
  cancelledBy         User?                          @relation("AccountingDocumentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  lines               AccountingDocumentLine[]
  reconciliationLines AccountingReconciliationLine[]
  orders              AccountingDocumentOrder[]
  paymentAllocations  AccountingPaymentAllocation[]
  revaluationLines    CurrencyRevaluationLine[]
  sourceLinks         AccountingDocumentLink[]       @relation("AccountingDocumentSourceLinks")
  targetLinks         AccountingDocumentLink[]       @relation("AccountingDocumentTargetLinks")

  // Направление входит в ключ, потому что номера выдаются отдельными
  // последовательностями для исходящих и входящих (см.
  // AccountingDocumentNumbering). Без направления первый входящий счёт
  // сталкивался с исходящим «СЧ-2026-000001», и создать его было нельзя.
  @@unique([companyId, type, direction, number])
  @@index([companyId, documentDate])
  @@index([companyId, status])
  @@index([counterpartyId, documentDate])
  @@index([companyId, counterpartyId, externalNumber])
  @@index([contractId])
  /// Доставка документа контрагенту на платформе.
  ///
  /// Документ остаётся один: у него уже есть companyId (кто выпустил) и
  /// counterpartyId (кому). Здесь — реальная компания-арендатор, которой
  /// открыт доступ на чтение. Копий не появляется, и не приходится решать,
  /// чей номер правильный. Пусто означает «не отправляли» или «у контрагента
  /// нет учётной записи» — тогда остаётся публичная ссылка.
  recipientCompanyId String?
  recipientCompany   Company? @relation("ReceivedAccountingDocuments", fields: [recipientCompanyId], references: [id], onDelete: SetNull)
  sentAt             DateTime?
  sentById           String?
  sentBy             User?    @relation("SentAccountingDocuments", fields: [sentById], references: [id], onDelete: SetNull)

  /// Что получатель сделал с документом: ACCEPTED или REJECTED с причиной.
  /// Пусто — ещё не смотрел. Править чужой документ он не может, только
  /// принять или отклонить.
  receiptStatus String?
  receiptReason String?
  receiptAt     DateTime?
  receiptById   String?
  receiptBy     User?     @relation("ReviewedAccountingDocuments", fields: [receiptById], references: [id], onDelete: SetNull)

  @@index([recipientCompanyId])

}

model AccountingDocumentLine {
  id             String                   @id @default(cuid())
  documentId     String
  document       AccountingDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNumber     Int
  serviceCode    String?
  name           String
  description    String?
  serviceDate    DateTime?                @db.Date
  reportDetails  String?
  quantity       Decimal                  @default(1) @db.Decimal(20, 3)
  unit           String                   @default("усл") @db.VarChar(32)
  unitCode       String?
  unitPrice      Decimal                  @db.Decimal(20, 2)
  subtotal       Decimal                  @db.Decimal(20, 2)
  discountAmount Decimal                  @default(0) @db.Decimal(20, 2)
  vatTreatment   AccountingVatTreatment   @default(WITHOUT_VAT)
  vatCalculation AccountingVatCalculation @default(INCLUDED)
  vatRate        Decimal                  @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal                  @default(0) @db.Decimal(20, 2)
  total          Decimal                  @db.Decimal(20, 2)
  orderId        String?
  order          Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime                 @default(now())

  @@unique([documentId, lineNumber])
  @@index([orderId])
}

model AccountingReconciliationLine {
  id                   String             @id @default(cuid())
  documentId           String
  document             AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNumber           Int
  transactionDate      DateTime           @db.Date
  sourceDocumentType   String?
  sourceDocumentNumber String?
  description          String?
  debit                Decimal            @default(0) @db.Decimal(20, 2)
  credit               Decimal            @default(0) @db.Decimal(20, 2)
  runningBalance       Decimal            @db.Decimal(20, 2)
  createdAt            DateTime           @default(now())

  @@unique([documentId, lineNumber])
  @@index([transactionDate])
}

model AccountingDocumentOrder {
  id         String             @id @default(cuid())
  documentId String
  document   AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())

  @@unique([documentId, orderId])
  @@index([orderId])
}

/// Доля платежа, закрывающая конкретную заявку.
///
/// Один платёж — много заявок. Так работает бухгалтерия у заказчиков:
/// приходит один перевод, и в нём сидят двадцать рейсов. До этого платёж
/// умел ссылаться ровно на одну заявку, и закрыть двадцать можно было
/// только двадцатью записями — выписка банка после этого не сходилась со
/// списком платежей ни по одной строке.
///
/// Сумма доли — в валюте платежа; в тенге она пересчитана по курсу дня
/// оплаты, зафиксированному в самом платеже, и потому не меняется задним
/// числом вместе с курсом.
model PaymentOrderShare {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount     Decimal  @db.Decimal(20, 2)
  /// Та же доля в учётной валюте — по курсу, записанному в платеже.
  amountBase Decimal? @db.Decimal(20, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, orderId])
  @@index([orderId])
}

model AccountingPaymentAllocation {
  id          String             @id @default(cuid())
  documentId  String
  document    AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  paymentId   String
  payment     Payment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// Сколько долга закрыто — в валюте счёта.
  amount      Decimal            @db.Decimal(20, 2)
  /// Сколько на это ушло в учётной валюте и какая курсовая разница при этом
  /// возникла. Считается один раз, в момент погашения: пересчёт задним
  /// числом менял бы прошлые месяцы при каждом движении курса.
  amountBase   Decimal? @db.Decimal(20, 2)
  exchangeDiff Decimal? @db.Decimal(20, 2)
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())

  @@unique([documentId, paymentId])
  @@index([paymentId])
}

/// Сформированный договор-заявка на перевозку.
///
/// Хранит СНИМОК данных заявки на момент формирования: подписанный
/// документ не должен меняться, если заявку потом правят. Изменилась
/// сумма — формируется новая версия, прежняя остаётся в истории.
///
/// Своего номера у документа нет намеренно: в печатной форме стоит номер
/// заявки, как в образце заказчика. Версия — внутренний признак платформы
/// и в документ не попадает, иначе на официальной бумаге появилась бы
/// пометка «исправление».
/// Вид документа по рейсу, который сохраняется версиями.
enum OrderDocumentKind {
  /// Договор-заявка на перевозку.
  CONTRACT
  /// Доверенность на водителя (форма М-2).
  POWER_OF_ATTORNEY
}

/// Сформированный документ по рейсу со снимком данных.
///
/// Печатная форма собирается из заявки, а заявку правят: меняется ставка,
/// водитель, дата. Подписанный документ от этого меняться не должен, поэтому
/// каждое формирование сохраняет снимок и получает свой номер версии.
/// Прежние версии не удаляются — «исправленный» документ добавляется рядом.
/// Номера версии в самой печатной форме нет: это внутренняя пометка
/// платформы, а не реквизит официального бланка.
model OrderDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("CompanyOrderDocuments", fields: [companyId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation("OrderDocuments", fields: [orderId], references: [id], onDelete: Cascade)

  kind OrderDocumentKind

  /// Порядковый номер версии в рамках заявки и вида документа: 1, 2, 3…
  version  Int
  /// Данные заявки и сторон на момент формирования.
  snapshot Json

  createdById String
  createdBy   User     @relation("CreatedOrderDocuments", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  // ─── Черновик → проведён → отправлен ───
  //
  // Раньше этих состояний не было: документ появлялся сразу готовым, и печать
  // с подписью ставились одной кнопкой — любым, кто ведёт рейс. Заверенный
  // документ с чужой ошибкой уходил контрагенту, и узнавали об этом от него.
  //
  // DRAFT — сформирован, годится для согласования, печати на нём нет.
  // POSTED — проверен и заверен: содержимое замерло, можно печатать и
  //          отправлять. Исправление — не правка, а следующая версия.
  // SENT   — ушёл получателю.
  status     String    @default("DRAFT")
  postedAt   DateTime?
  postedById String?
  postedBy   User?     @relation("PostedOrderDocuments", fields: [postedById], references: [id], onDelete: SetNull)

  /// Кому этот документ выписан — компания из справочника на момент
  /// формирования. Хранится у документа, а не берётся из заявки на лету:
  /// перевозчика в рейсе могут поменять, а документ выписан прежнему, и
  /// «отправить перевозчику» должно означать того, кто стоит в бумаге.
  recipientCounterpartyId String?
  /// Кому доставлен на платформе, если у получателя есть кабинет.
  recipientCompanyId      String?
  /// Куда ушёл по почте, если кабинета у получателя нет.
  sentToEmail             String?
  sentAt                  DateTime?
  sentById                String?
  sentBy                  User?     @relation("SentOrderDocuments", fields: [sentById], references: [id], onDelete: SetNull)

  /// Что получатель ответил: ACCEPTED или REJECTED с причиной.
  receiptStatus String?
  receiptReason String?
  receiptAt     DateTime?

  /// Какую версию заменяет этот документ. Отправить исправление можно, а вот
  /// оставить у контрагента два разных документа с одним номером — нельзя:
  /// у него в кабинете прежний помечается заменённым.
  replacesId String?

  @@unique([orderId, kind, version])
  @@index([companyId, kind, createdAt])
  @@index([recipientCompanyId])
}

model AccountingDocumentLink {
  id               String                     @id @default(cuid())
  sourceDocumentId String
  sourceDocument   AccountingDocument         @relation("AccountingDocumentSourceLinks", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocumentId String
  targetDocument   AccountingDocument         @relation("AccountingDocumentTargetLinks", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  type             AccountingDocumentLinkType
  createdAt        DateTime                   @default(now())

  @@unique([sourceDocumentId, targetDocumentId, type])
  @@index([targetDocumentId])
}

model AccountingDocumentNumbering {
  id         String                      @id @default(cuid())
  companyId  String
  company    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type       AccountingDocumentType
  direction  AccountingDocumentDirection
  year       Int
  prefix     String                      @default("")
  nextNumber Int                         @default(1)
  padLength  Int                         @default(6)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@unique([companyId, type, direction, year])
  @@index([companyId])
}

model UserCompanyRelation {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole @default(COMPANY_ADMIN)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

// Нововведения платформы: черновики генерирует ИИ из коммитов, админ подтверждает
model PlatformUpdate {
  id            String    @id @default(cuid())
  title         String
  description   String
  sourceCommits String[]  @default([]) // sha коммитов-источников (для дедупликации)
  status        String    @default("DRAFT") // DRAFT | PUBLISHED | REJECTED
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([status])
  @@index([createdAt])
}

// Тикеты поддержки, сформулированные ИИ-ассистентом из обращений пользователей
model SupportTicket {
  id          String   @id @default(cuid())
  companyId   String
  companyName String
  userId      String
  userName    String
  userEmail   String?
  title       String
  category    String   @default("other") // finance | orders | documents | display | other
  severity    String   @default("medium") // low | medium | high
  description String
  orders      String[] @default([]) // номера связанных заявок
  details     Json? // структура: process / where / expected / actual
  transcript  Json? // диалог пользователя с ассистентом
  status      String   @default("NEW") // NEW | IN_PROGRESS | DONE | REJECTED

  /// Ответ поддержки — тот, что видит компания у себя.
  ///
  /// Без него обращение было дорогой в один конец: письмо уходило в
  /// телеграм владельцу, а человек на другом конце видел только «принято»
  /// и не знал, чем всё кончилось.
  answer     String?
  answeredAt DateTime?
  /// Кто ответил — чтобы через месяц было к кому вернуться с вопросом.
  answeredById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Когда обращение ушло владельцу в телеграм. Пусто — значит не уходило:
  // либо оно старше самой отправки, либо телеграм в тот момент не ответил.
  // По этому полю админка досылает пропущенное и не отправляет одно дважды.
  telegramSentAt DateTime?

  @@index([status])
  @@index([companyId])
  @@index([createdAt])
  @@index([telegramSentAt])
}

model PayrollScheme {
  id            String   @id @default(cuid())
  companyId     String
  userId        String? // null = общая схема компании; задан = персональная (переопределяет общую)
  type          String // FIXED | PERCENT | HYBRID
  fixedAmount   Decimal  @default(0) @db.Decimal(18, 2) // оклад в месяц (для FIXED и HYBRID)
  percentValue  Decimal  @default(0) @db.Decimal(5, 2) // процент (для PERCENT и HYBRID)
  percentBase   String   @default("MARGIN") // MARGIN | ORDER_AMOUNT — база процента
  accrualStatus String   @default("COMPLETED") // статус заявки-триггер: любой OrderStatus ИЛИ спец-значение CUSTOMER_PAID
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
}

model PayrollKpiRule {
  id          String   @id @default(cuid())
  companyId   String
  userId      String? // null = для всех менеджеров компании
  metric      String   @default("COMPLETED_ORDERS_MONTH") // v1: количество завершённых заявок за месяц
  threshold   Int // порог (например 20 заявок)
  bonusAmount Decimal  @db.Decimal(18, 2) // бонус при достижении
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model PayrollAccrual {
  id             String   @id @default(cuid())
  companyId      String
  userId         String // менеджер
  orderId        String? // для kind=PERCENT; null для SALARY/KPI
  kind           String // PERCENT | SALARY | KPI
  amount         Decimal  @db.Decimal(18, 2)
  periodMonth    String // 'YYYY-MM' — месяц начисления
  baseAmount     Decimal? @db.Decimal(18, 2) // база на момент расчёта (сумма заявки или маржа)
  schemeSnapshot Json? // снимок схемы/правила на момент расчёта
  kpiRuleId      String?
  createdAt      DateTime @default(now())

  @@unique([orderId, userId, kind]) // защита от двойного начисления по заявке
  @@unique([userId, periodMonth, kind, kpiRuleId]) // защита для SALARY/KPI за месяц
  @@index([companyId, periodMonth])
  @@index([userId, periodMonth])
}

// ==================== БИЛЛИНГ (подписки компаний) ====================

// Глобальные настройки платформы (ключ-значение)
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String
  description       String?
  priceMonthly      Int // тенге в месяц
  currency          String   @default("KZT")
  maxUsers          Int? // null = без лимита
  maxOrdersPerMonth Int? // null = без лимита
  features          String[] @default([])
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions CompanySubscription[]
}

enum SubscriptionStatus {
  TRIAL // Пробный период у новой компании
  GRACE // Дни на оплату у тех, кто работал до включения оплаты
  ACTIVE // Оплачена
  PAST_DUE // Просрочена
  CANCELLED // Отменена
}

model CompanySubscription {
  id        String             @id @default(cuid())
  companyId String             @unique
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String?
  plan      SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  status    SubscriptionStatus @default(TRIAL)
  /// До какого момента компания работает бесплатно.
  ///
  /// Одно поле на два разных повода, и это намеренно: и в пробном периоде,
  /// и в днях на оплату речь про одно и то же — до какого числа кабинет
  /// открыт без денег. Различает их статус: TRIAL у новой компании, GRACE
  /// у тех, кто уже работал, когда владелец назначил цену.
  trialEndsAt DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  note        String? // Комментарий админа (№ счёта, детали оплаты)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

enum SubscriptionRequestStatus {
  PENDING // Компания попросила счёт, ответа ещё нет
  APPROVED // Оплата получена, срок продлён
  REJECTED // Отказано
}

/// Запрос компании на покупку подписки.
///
/// Оплата идёт по счёту мимо платформы, поэтому кнопка «Купить» не может
/// ничего списать. Она делает единственное, что здесь имеет смысл: оставляет
/// заявку — какая компания, на сколько месяцев и на какую сумму. Владелец
/// платформы видит её в биллинге, выставляет счёт и после оплаты продлевает
/// подписку одной кнопкой.
model SubscriptionRequest {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  months Int // на сколько месяцев просят
  amount Int // сумма в тенге на момент запроса
  planId String? // какой тариф показывали компании (снимок, без связи)

  /// Кто нажал кнопку. Снимок, как в аудит-логе: сотрудник может уволиться,
  /// а запрос должен остаться читаемым.
  requestedById String?
  requesterName String?
  comment       String? // сообщение от компании

  status       SubscriptionRequestStatus @default(PENDING)
  decisionNote String? // № счёта или причина отказа
  decidedAt    DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([companyId, status])
}

// ==================== АУДИТ-ЛОГ ДЕЙСТВИЙ ====================

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String? // null = платформенное событие
  userId      String?
  userName    String? // снимок ФИО на момент действия
  userRole    String?
  action      String // CREATE / UPDATE / DELETE / STATUS / SETTINGS
  entity      String // order, expense, income, payment, partner, employee, driver, subscription, ...
  entityId    String?
  entityLabel String? // «Заявка №145», «Расход ГСМ 80 000 ₸»
  details     Json? // старые/новые значения ключевых полей
  createdAt   DateTime @default(now())

  /// К какому рейсу относится действие. Нужен, чтобы карточка заявки могла
  /// показать свою историю: кто вложил документ, кто поменял груз, кто
  /// переназначил водителя. Без него запись про документ ссылается на сам
  /// документ, и собрать ленту по рейсу нечем.
  orderId String?

  @@index([companyId, createdAt])
  @@index([createdAt])
  @@index([orderId, createdAt])
}

// Ответственный менеджер от каждой компании-участника заявки
model OrderResponsible {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation("CompanyOrderResponsibilities", fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserOrderResponsibilities", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, companyId])
  @@index([userId])
  @@index([companyId])
}

/// Состояние присланного контрагентом подтверждения оплаты.
enum PaymentProofStatus {
  /// Прислан, ждёт проверки бухгалтера.
  PENDING
  /// Бухгалтер сверил и подтвердил.
  ACCEPTED
  /// Отклонён: сумма не та, чужой платёж, нечитаемый файл.
  REJECTED
}

/// С какой стороны пришло заявление о деньгах.
///
/// Обе стороны расчётов могут ошибиться, и спорят они о разном. Плательщик
/// заявляет «я перевёл» и прикладывает платёжку. Получатель заявляет «мне
/// пришло не столько, сколько у вас записано» — и прикладывать ему нечего,
/// выписка у него своя. Одна очередь на бухгалтера, но два разных смысла,
/// и путать их в отчётах нельзя.
enum PaymentProofKind {
  /// «Я заплатил» — от того, кто переводил деньги.
  PAYMENT
  /// «Мне пришло столько» — от того, кто их получал.
  RECEIPT
}

/// Чек об оплате, присланный контрагентом по ссылке на отчёт.
///
/// Это ЗАЯВЛЕНИЕ стороны, а не факт поступления денег. Поэтому чек не
/// создаёт платёж и не гасит долг сам по себе: иначе любой, у кого есть
/// ссылка, закрывал бы свою задолженность картинкой. Деньги проводит
/// бухгалтер после сверки с банком.
model OrderPaymentProof {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Чья бухгалтерия проверяет чек — получатель денег.
  companyId String
  company   Company @relation("CompanyPaymentProofs", fields: [companyId], references: [id], onDelete: Cascade)

  /// Кто прислал.
  counterpartyId String
  counterparty   Company @relation("CounterpartyPaymentProofs", fields: [counterpartyId], references: [id], onDelete: Cascade)

  /// По какой ссылке пришёл — чтобы было видно происхождение.
  sharedReportLinkId String?

  /// С какой стороны заявление: «я заплатил» или «мне пришло столько».
  kind PaymentProofKind @default(PAYMENT)

  /// Файл. Обязателен для платежа и не нужен получателю: у того своя
  /// выписка, а прикладывать ему нечего — он только называет сумму.
  fileName String?
  fileUrl  String?
  fileSize Int?
  mimeType String?

  /// Сумма и дата со слов отправителя. Проверяются, а не принимаются на веру.
  claimedAmount Decimal?  @db.Decimal(20, 2)
  claimedDate   DateTime? @db.Date
  note          String?

  status          PaymentProofStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?              @relation("ReviewedPaymentProofs", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([companyId, status])
  @@index([orderId])
}

/// Кому слать доверенность по этому адресу — список у каждой компании свой.
///
/// В самом адресе почты держать нельзя: справочник адресов общий, у складов
/// `companyId` пустой, и правка возвращала 403 — справедливо, иначе одна
/// компания перетирала бы контакты другой. Поэтому список привязан к паре
/// «адрес + компания».
model LocationEmailList {
  id         String   @id @default(cuid())
  locationId String
  companyId  String
  /// Почты через запятую. Числом не ограничены: у крупного склада их
  /// бывает и пятнадцать, и пятьдесят.
  emails     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([locationId, companyId])
  @@index([companyId])
}

// ==================== ВАЛЮТЫ И КУРСЫ ====================

/// Справочник валют.
///
/// Заполняется из курсов Нацбанка РК плюс сам тенге и те валюты, которых
/// Нацбанк не публикует (туркменский манат). Код — ISO 4217: он же в
/// платёжках, в 1С и в банке, поэтому свой идентификатор заводить незачем.
model Currency {
  /// KZT, USD, RUB — три буквы по ISO 4217.
  code   String  @id @db.VarChar(3)
  nameRu String
  /// Знак валюты, если он есть и общеупотребим: ₸, $, ₽. Иначе показываем код.
  symbol String?

  /// За сколько единиц Нацбанк публикует курс: 1, 10, 100, 1000, 10000.
  ///
  /// Это не украшение: узбекский сум идёт за 100, армянский драм за 10,
  /// иранский риал за 10 000. Взять курс как есть — ошибиться в сто раз, и
  /// заметить это можно уже после того, как счёт ушёл клиенту. Поэтому при
  /// загрузке курс разворачивается в «тенге за одну единицу», а исходные
  /// число и кратность сохраняются рядом для сверки.
  quant Int @default(1)

  /// Показывать в коротком списке. Здесь СНГ, соседи и мировые валюты —
  /// то, в чём реально ездят перевозки. Остальные доступны через поиск.
  isCommon Boolean @default(false)

  /// Публикует ли Нацбанк официальный курс. У туркменского маната — нет,
  /// его курс придётся ставить руками, и человек должен понимать почему.
  hasOfficialRate Boolean @default(true)

  /// Порядок показа: сперва тенге, потом СНГ, потом мир.
  sortOrder Int @default(500)

  rates        ExchangeRate[]
  companyRates CompanyExchangeRate[]

  @@index([isCommon, sortOrder])
}

/// ОФИЦИАЛЬНЫЙ курс валюты к тенге на дату — общий для всей платформы.
///
/// Курс Нацбанка один для всех, поэтому таблица не привязана к компании.
/// Свой курс компании (по договору, или для валюты без официального курса)
/// живёт отдельно — см. `CompanyExchangeRate`. Разделение не украшение:
/// пока обе разновидности лежали в одной таблице, курс, поставленный одной
/// компанией, применялся ко всем остальным.
///
/// Правило, ради которого всё это существует: курс, по которому провели
/// документ, менять нельзя никогда. Поэтому курсы хранятся историей по
/// датам, а не одним «текущим значением», и старые записи не переписываются
/// при загрузке новых.
model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String   @db.VarChar(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)

  /// Дата, НА КОТОРУЮ курс действует.
  ///
  /// По субботам и воскресеньям Нацбанк повторяет числа последнего рабочего
  /// дня — то есть в выходные действует пятничный курс. Кроме того, дней
  /// может не быть в базе вовсе: сервис был недоступен, компания начала
  /// работать позже, документ проводят задним числом. Поэтому курс на дату
  /// всегда берётся с откатом к последней записи не позже неё.
  rateDate DateTime @db.Date

  /// Сколько тенге за ОДНУ единицу валюты. Кратность уже развёрнута.
  rate Decimal @db.Decimal(18, 6)

  /// Как это отдал Нацбанк — для сверки глазами с сайтом.
  sourceRate  Decimal? @db.Decimal(18, 6)
  sourceQuant Int?

  createdById String?
  createdBy   User?   @relation("ExchangeRateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([currencyCode, rateDate])
  @@index([rateDate])
}

/// Свой курс компании на дату.
///
/// Нужен в двух случаях: у валюты нет официального курса Нацбанка (так с
/// туркменским манатом) или в договоре с клиентом зафиксирован свой курс.
///
/// Отдельная таблица, а не признак в общей: курс по договору — коммерческая
/// договорённость одной компании, и другим компаниям платформы её видеть
/// нельзя. Официальный курс при этом остаётся нетронутым и общим, поэтому
/// «затереть курс Нацбанка» здесь невозможно устройством, а не проверкой.
model CompanyExchangeRate {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currencyCode String   @db.VarChar(3)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)

  rateDate DateTime @db.Date
  /// Сколько тенге за ОДНУ единицу валюты.
  rate     Decimal  @db.Decimal(18, 6)
  /// Зачем поставили: «курс по договору», «Нацбанк не публикует».
  note     String?

  createdById String?
  createdBy   User?   @relation("CompanyExchangeRateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, currencyCode, rateDate])
  @@index([companyId, rateDate])
}

/// Переоценка валютных остатков на дату — обычно на конец месяца.
///
/// Курсовая разница возникает не только когда деньги пришли. Пока валютный
/// счёт лежит, а долг клиента не оплачен, курс всё равно движется, и на
/// конец месяца тот же остаток стоит других тенге. Хранится снимком:
/// пересчёт при каждом показе означал бы, что прошлый месяц меняется сам
/// по себе при каждом движении курса.
model CurrencyRevaluation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Дата, на которую переоценены остатки.
  date        DateTime @db.Date
  createdById String
  createdBy   User     @relation("CreatedCurrencyRevaluations", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  note        String?

  /// Доход и расход по отдельности: «ноль» вместо «выиграли и потеряли
  /// поровну» скрыл бы движение денег.
  gain  Decimal @default(0) @db.Decimal(20, 2)
  loss  Decimal @default(0) @db.Decimal(20, 2)
  lines CurrencyRevaluationLine[]

  /// Одна переоценка на компанию на дату: две задвоили бы разницу.
  @@unique([companyId, date])
  @@index([companyId, date])
}

/// Один переоценённый остаток: счёт, долг клиента или наш долг перевозчику.
model CurrencyRevaluationLine {
  id            String              @id @default(cuid())
  revaluationId String
  revaluation   CurrencyRevaluation @relation(fields: [revaluationId], references: [id], onDelete: Cascade)

  /// ACCOUNT — остаток на счёте, RECEIVABLE — долг клиента,
  /// PAYABLE — наш долг перевозчику.
  kind       String
  accountId  String?
  account    FinanceAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  documentId String?
  document   AccountingDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  currency String
  /// Остаток в валюте и курс, по которому его переоценили.
  amount   Decimal @db.Decimal(20, 2)
  rate     Decimal @db.Decimal(18, 6)
  /// Было в тенге, стало в тенге и разница между ними.
  baseBefore Decimal @db.Decimal(20, 2)
  baseAfter  Decimal @db.Decimal(20, 2)
  diff       Decimal @db.Decimal(20, 2)

  @@index([revaluationId])
  /// По этим двум ищется предыдущая переоценка остатка: следующая разница
  /// считается от неё, а не от курса документа.
  @@index([documentId])
  @@index([accountId])
}
