model AccountingReconciliationLine {
  id                   String             @id @default(cuid())
  documentId           String
  document             AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNumber           Int
  transactionDate      DateTime           @db.Date
  sourceDocumentType   String?
  sourceDocumentNumber String?
  description          String?
  debit                Decimal            @default(0) @db.Decimal(20, 2)
  credit               Decimal            @default(0) @db.Decimal(20, 2)
  runningBalance       Decimal            @db.Decimal(20, 2)
