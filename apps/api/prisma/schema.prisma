// Prisma Schema for LogComp
// Logistics Management System

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum PriceType {
  FIXED // Всего
  PER_KM // За км
  PER_TON // За тонну
}

enum UserRole {
  ADMIN // Наша компания (LogComp)
  COMPANY_ADMIN // Админ компании-клиента (Заказчик)
  LOGISTICIAN // Логист (создаёт заявки)
  WAREHOUSE_MANAGER // Завсклад (управляет очередью)
  ACCOUNTANT // Бухгалтер
  DRIVER // Водитель
  RECIPIENT // Грузополучатель
  PARTNER // Иная ТК (субподрядчик)
  FORWARDER // Экспедитор
}

enum OrderStatus {
  DRAFT // Черновик
  PENDING // Ожидает назначения
  ASSIGNED // Назначен водитель
  EN_ROUTE_PICKUP // Водитель едет на погрузку
  AT_PICKUP // Водитель на месте погрузки
  LOADING // Идет погрузка
  IN_TRANSIT // В пути
  AT_DELIVERY // Прибыл на выгрузку
  UNLOADING // Идет разгрузка
  COMPLETED // Завершен
  CANCELLED // Отменен
  PROBLEM // Проблема
}

enum DocumentType {
  TTN // Товарно-транспортная накладная
  POWER_OF_ATTORNEY // Доверенность
  ACT // Акт
  INVOICE // Счет
  OTHER // Прочее

  // Пакет для подтверждения компании (практика РК)
  COMPANY_REGISTRATION // Справка о гос. регистрации юрлица с eGov
  DIRECTOR_APPOINTMENT // Приказ (решение) о назначении первого руководителя
  DIRECTOR_ID // Удостоверение личности руководителя
}

/// Жизненный цикл подтверждения компании владельцем платформы.
/// Работать (создавать заявки и документы) может только VERIFIED.
enum CompanyVerificationStatus {
  DRAFT // Создана, документы ещё не поданы
  PENDING // Подана на проверку, ждёт решения владельца платформы
  VERIFIED // Подтверждена — компания может работать
  REJECTED // Отклонена, причина в rejectionReason; можно подать заново
}

enum CompanyType {
  CUSTOMER // Заказчик
  FORWARDER // Экспедитор
}

enum RoutePointType {
  PICKUP // Погрузка
  ADDITIONAL_PICKUP // Догруз
  DELIVERY // Выгрузка
}

enum ContractStatus {
  DRAFT // Черновик
  PENDING // На согласовании
  ACTIVE // Активен
  EXPIRED // Истёк
  TERMINATED // Расторгнут
}

enum AgreementStatus {
  DRAFT // Черновик
  PENDING // На согласовании у заказчика
  APPROVED // Утверждено обеими сторонами
  REJECTED // Отклонено
  EXPIRED // Истекло
}

// Фаза 2: тип членства человека в компании
enum AffiliationType {
  EMPLOYEE // штатный сотрудник/водитель
  PRIVATE_CARRIER // частный перевозчик (физлицо со своей машиной)
  COLLABORATOR // приглашённый/внешний (задел на будущее)
}

// ==================== MODELS ====================

model User {
  exchangeRates         ExchangeRate[]        @relation("ExchangeRateAuthor")
  companyExchangeRates  CompanyExchangeRate[] @relation("CompanyExchangeRateAuthor")
  id                    String                @id @default(cuid())
  /// Компании, которые этот пользователь подтвердил как админ платформы.
  verifiedCompanies     Company[]             @relation("VerifiedCompanies")
  createdOrderDocuments OrderDocument[]       @relation("CreatedOrderDocuments")
  postedOrderDocuments  OrderDocument[]       @relation("PostedOrderDocuments")
  sentOrderDocuments    OrderDocument[]       @relation("SentOrderDocuments")
  createdCurrencyRevaluations CurrencyRevaluation[] @relation("CreatedCurrencyRevaluations")
  sentAccountingDocuments     AccountingDocument[]  @relation("SentAccountingDocuments")
  reviewedAccountingDocuments AccountingDocument[]  @relation("ReviewedAccountingDocuments")
  createdSharedReports  SharedReportLink[]    @relation("CreatedSharedReports")
  reviewedPaymentProofs OrderPaymentProof[]   @relation("ReviewedPaymentProofs")
  email                 String?               @unique
  googleId              String?               @unique // Google OAuth ID
  phone                 String
  passwordHash          String? // null для водителей (SMS auth)
  firstName             String
  lastName              String
  middleName            String?
  role                  UserRole
  position              String? // Должность/роль
  avatarPath            String? // Фото профиля (S3-ключ или локальный путь)
  permissions           String[]              @default([])
  isActive              Boolean               @default(true)
  isTrackable           Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  sessions                     Session[]
  ordersAsCustomer             Order[]                       @relation("CustomerOrders")
  ordersAsDriver               Order[]                       @relation("DriverOrders")
  ordersAsRecipient            Order[]                       @relation("RecipientOrders")
  ordersAsManager              Order[]                       @relation("ManagerOrders")
  bonuses                      Bonus[]
  gpsPoints                    GpsPoint[]
  documents                    Document[]
  orderAssignments             OrderAssignee[]               @relation("OrderAssignees")
  orderResponsibilities        OrderResponsible[]            @relation("UserOrderResponsibilities")
  managedExternalCompanies     Company[]                     @relation("ExternalCompanyManager")
  orderChangeLogs              OrderChangeLog[]              @relation("OrderChangeLogs")
  closedPeriods                ClosedPeriod[]
  accountingDocumentsCreated   AccountingDocument[]          @relation("AccountingDocumentCreatedBy")
  accountingDocumentsPosted    AccountingDocument[]          @relation("AccountingDocumentPostedBy")
  accountingDocumentsCancelled AccountingDocument[]          @relation("AccountingDocumentCancelledBy")
  accountingPaymentAllocations AccountingPaymentAllocation[]
  userCompanyRelations         UserCompanyRelation[]

  // Компания (для PARTNER и WAREHOUSE)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Фаза 1 (мультикомпанийная архитектура): ссылка на глобальную личность.
  // Пока НЕ используется существующей логикой — заполняется бэкфиллом, служит фундаментом.
  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  // Отдел сотрудника
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Водитель: данные транспорта
  iin           String? // ИИН
  vehicleType   String? // Тип транспорта (Тент, Реф и т.д.)
  vehiclePlate  String? // Госномер
  vehicleModel  String? // Модель авто
  trailerNumber String? // Номер прицепа

  // Водитель: документы (удостоверение/паспорт)
  docType           String? // Тип документа: "ID_CARD" или "PASSPORT"
  docNumber         String? // Номер документа
  docIssuedAt       DateTime? // Дата выдачи
  docExpiresAt      DateTime? // Срок действия
  docIssuedBy       String? // Кем выдан
  // Комиссия менеджера (% от маржи)
  commissionPercent Decimal   @default(0) @db.Decimal(5, 2)

  @@index([phone])
  @@index([role])
  @@index([departmentId])
  @@index([personId])
}

// ==================== ФАЗА 1: Личность (глобальная идентичность человека) ====================
// Отдельная сущность «человек», не привязанная к компании. Фундамент для того, чтобы один
// физический водитель/сотрудник не дублировался между компаниями. На этом этапе создаётся
// бэкфиллом 1:1 и НЕ участвует в существующей логике — ничего не ломает.
model Person {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  middleName String?
  phone      String?
  iin        String? // ИИН
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Обратимое слияние: исходная личность не удаляется, а помечается «слита в …».
  // При откате пометка снимается, пользователи возвращаются на свои прежние личности.
  mergedIntoId String?
  mergedInto   Person?  @relation("PersonMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Person[] @relation("PersonMerge")

  users            User[]
  affiliations     Affiliation[]
  ownedVehicles    Vehicle[]     @relation("PersonOwnedVehicles")
  operatedVehicles Vehicle[]     @relation("PersonOperatedVehicles")

  @@index([phone])
  @@index([iin])
  @@index([mergedIntoId])
}

// Фаза 2: членство человека в компании (обобщает User.companyId + UserCompanyRelation).
// Один человек может иметь несколько affiliation'ов: штатный в одной, частный перевозчик в
// другой, и т.д. — без дублирования. На этом этапе таблица ЗАПОЛНЯЕТСЯ бэкфиллом и НЕ читается
// существующей логикой — ничего не ломает. Переключение чтения на неё — отдельная будущая фаза.
model Affiliation {
  id           String          @id @default(cuid())
  personId     String
  person       Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company         @relation("CompanyAffiliations", fields: [companyId], references: [id], onDelete: Cascade)
  type         AffiliationType @default(EMPLOYEE)
  role         UserRole
  position     String?
  departmentId String?
  status       String          @default("ACTIVE") // ACTIVE | ARCHIVED
  isPrimary    Boolean         @default(false) // домашняя компания (соответствует User.companyId)
  rate         Decimal?        @db.Decimal(18, 2) // задел под кадры (ставка) — пока не используется
  startedAt    DateTime?
  endedAt      DateTime?
  sourceUserId String? // из какого User сгенерирована связь (для сверки бэкфилла)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([personId, companyId, role])
  @@index([personId])
  @@index([companyId])
  @@index([companyId, role])
}

// Журнал объединений личностей — чтобы любое слияние можно было полностью откатить.
model PersonMerge {
  id             String    @id @default(cuid())
  targetPersonId String // основная личность, в которую объединяли
  status         String    @default("ACTIVE") // ACTIVE | REVERTED
  createdById    String? // кто выполнил объединение
  createdAt      DateTime  @default(now())
  revertedAt     DateTime?

  items PersonMergeItem[]

  @@index([targetPersonId])
  @@index([status])
}

// Пооперационная запись: какой пользователь и с какой прежней личности был перецеплен.
model PersonMergeItem {
  id               String      @id @default(cuid())
  mergeId          String
  merge            PersonMerge @relation(fields: [mergeId], references: [id], onDelete: Cascade)
  userId           String // перецепленный пользователь
  previousPersonId String // личность, на которую вернуть при откате

  @@index([mergeId])
  @@index([userId])
}

model Company {
  exchangeRates CompanyExchangeRate[]

  /// Учётная валюта компании: в ней считаются отчёты, прибыль и долги.
  ///
  /// У казахстанской компании это тенге, у российской был бы рубль. Валюта
  /// документа может быть любой, но сравнивать и складывать суммы можно
  /// только приведёнными к одной — вот к этой.
  baseCurrency  String  @default("KZT") @db.VarChar(3)
  id            String  @id @default(cuid())
  name          String
  bin           String? // БИН/ИИН
  address       String? // Юридический адрес
  actualAddress String? // Фактический адрес
  phone         String?
  email         String? // Email компании
  directorName  String? // ФИО директора
  bankAccount   String? // ИИК (номер счёта)
  bankName      String? // Название банка
  bankBic       String? // БИК банка
  kbe           String? // КБЕ

  // Реквизиты, которые печатаются в документах, но раньше их приходилось
  // вбивать в каждый документ руками (или они не печатались вовсе).
  /// КНП по умолчанию — код назначения платежа в счёте на оплату.
  paymentPurposeCode   String?
  /// Должность подписанта в актах и счетах: «Директор», «Генеральный директор».
  /// Раньше в акте была зашита строка «директор» независимо от компании.
  signatoryPosition    String?
  /// ФИО подписанта, если документы подписывает не директор.
  signatoryName        String?
  /// Свидетельство о постановке на учёт по НДС: печатается в счёте.
  /// Пустой номер означает, что компания не состоит на учёте по НДС.
  vatCertificateSeries String?
  vatCertificateNumber String?
  vatCertificateDate   DateTime?    @db.Date
  stampImage           String? // Путь к PNG печати
  signatureImage       String? // Путь к PNG подписи
  type                 CompanyType? @default(CUSTOMER)
  isCustomer           Boolean      @default(true)
  isCarrier            Boolean      @default(false)
  isOurCompany         Boolean      @default(false) // true = LogComp
  isExternal           Boolean      @default(false) // Внешняя компания (справочник)
  isActive             Boolean      @default(true)

  // Подтверждение компании владельцем платформы. БИН в РК — публичные
  // данные, поэтому сам по себе он ничего не доказывает: компания
  // допускается к работе только после проверки документов человеком.
  verificationStatus      CompanyVerificationStatus @default(DRAFT)
  verificationSubmittedAt DateTime?
  verifiedAt              DateTime?
  verifiedById            String?
  verifiedBy              User?                     @relation("VerifiedCompanies", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionReason         String?

  /// Отказ окончательный: заявку признали чужой.
  ///
  /// Обычный отказ — это замечание, после него документы прикладывают
  /// заново. Но если человек зарегистрировал чужую фирму, «исправить»
  /// ему нечего: он вернётся с тем же БИН завтра и послезавтра. Такой
  /// отказ закрывает и повторную подачу, и работу в кабинете — иначе
  /// он продолжит выставлять документы от имени чужой компании.
  verificationBlockedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Настройки видимости для менеджеров (LOGISTICIAN) этой компании
  managersSeeOwnOrdersOnly   Boolean @default(true) // менеджер видит только свои заявки
  managersSeeOwnPartnersOnly Boolean @default(false) // менеджер видит только своих контрагентов

  /// Как называется у этого заказчика его собственный номер перевозки и
  /// нужно ли печатать его в счёте.
  ///
  /// У крупных клиентов заявка живёт и в их системе тоже, под своим номером:
  /// у одного это «ID», у другого «Номер ТТН». Свой счёт они сверяют по нему,
  /// нашего номера рейса у них нет — не совпало, счёт вернули на переделку.
  /// Название у каждого своё, и кому печатать, а кому нет — тоже: поэтому не
  /// поле «ID» в коде, а настройка у контрагента.
  customerRefLabel        String?
  customerRefPrintInvoice Boolean @default(false)

  // Кто создал внешнюю компанию
  createdByCompanyId String?
  createdByCompany   Company?  @relation("ExternalCompanies", fields: [createdByCompanyId], references: [id])
  externalCompanies  Company[] @relation("ExternalCompanies")

  // Ответственный менеджер за внешнего контрагента (кто ведёт клиента)
  responsibleManagerId String?
  responsibleManager   User?   @relation("ExternalCompanyManager", fields: [responsibleManagerId], references: [id])

  users                User[]
  ordersAsPartner      Order[] @relation("PartnerOrders")
  ordersAsCustomer     Order[] @relation("CustomerCompanyOrders")
  ordersAsForwarder    Order[] @relation("ForwarderOrders")
  ordersAsSubForwarder Order[] @relation("SubForwarderOrders")

  // Partnerships
  sentRequests     Partnership[] @relation("PartnershipRequester")
  receivedRequests Partnership[] @relation("PartnershipRecipient")

  // Contracts
  contractsAsCustomer  Contract[] @relation("ContractCustomer")
  contractsAsForwarder Contract[] @relation("ContractForwarder")

  invitations                     Invitation[]
  locations                       Location[]                    @relation("CompanyLocations")
  departments                     Department[]
  vehicles                        Vehicle[]
  payments                        Payment[]                     @relation("CompanyPayments")
  counterpartyPayments            Payment[]                     @relation("CounterpartyPayments")
  financeOperations               FinanceOperation[]            @relation("CompanyFinanceOperations")
  counterpartyFinanceOperations   FinanceOperation[]            @relation("CounterpartyFinanceOperations")
  closedPeriods                   ClosedPeriod[]
  financeAccounts                 FinanceAccount[]              @relation("CompanyFinanceAccounts")
  financeCategories               FinanceCategory[]             @relation("CompanyFinanceCategories")
  accountingDocuments             AccountingDocument[]          @relation("AccountingDocumentCompany")
  accountingCounterpartyDocuments AccountingDocument[]          @relation("AccountingDocumentCounterparty")
  accountingDocumentNumberings    AccountingDocumentNumbering[]
  userCompanyRelations            UserCompanyRelation[]
  affiliations                    Affiliation[]                 @relation("CompanyAffiliations")
  documents                       Document[]
  documentsSentByLink             Document[]                    @relation("DocumentsFromCounterparty")
  subscription                    CompanySubscription?
  subscriptionRequests            SubscriptionRequest[]
  orderResponsibilities           OrderResponsible[]            @relation("CompanyOrderResponsibilities")
  counterpartyOpenings            CounterpartyOpeningBalance[]  @relation("CompanyCounterpartyOpenings")
  openingsAsCounterparty          CounterpartyOpeningBalance[]  @relation("CounterpartyOpenings")
  serviceCatalog                  ServiceCatalogItem[]          @relation("CompanyServiceCatalog")
  dictionaries                    DictionaryItem[]              @relation("CompanyDictionaries")
  orderNumbering                  OrderNumbering?               @relation("CompanyOrderNumbering")
  quoteRequests                   QuoteRequest[]                @relation("CompanyQuoteRequests")
  quoteRequestsAsCustomer         QuoteRequest[]                @relation("CustomerQuoteRequests")
  quoteRequestNumbering           QuoteRequestNumbering?        @relation("CompanyQuoteRequestNumbering")
  nomenclature                    NomenclatureItem[]            @relation("CompanyNomenclature")
  stockWarehouses                 StockWarehouse[]              @relation("CompanyWarehouses")
  stockMoves                      StockMove[]                   @relation("CompanyStockMoves")

  orderDocuments              OrderDocument[]     @relation("CompanyOrderDocuments")
  sharedReports               SharedReportLink[]  @relation("CompanySharedReports")
  sharedReportsAsCounterparty SharedReportLink[]  @relation("CounterpartySharedReports")
  paymentProofs               OrderPaymentProof[] @relation("CompanyPaymentProofs")
  currencyRevaluations        CurrencyRevaluation[]
  receivedAccountingDocuments AccountingDocument[] @relation("ReceivedAccountingDocuments")
  paymentProofsAsCounterparty OrderPaymentProof[] @relation("CounterpartyPaymentProofs")
  locationEmailLists          LocationEmailList[]

  @@index([bin])
  @@index([verificationStatus])
  /// Как считается НДС в счетах компании.
  ///
  /// STANDARD — со всей суммы счёта, как было всегда.
  /// FORWARDING — только с вознаграждения экспедитора: стоимость
  /// привлечённого перевозчика проходит через нас и нашим оборотом не
  /// является. Это налоговая позиция компании, а не оформление счёта,
  /// поэтому решение принимает бухгалтер и оно хранится у организации.
  vatScheme String @default("STANDARD")

  // ─── Блок «Расчёты»: условия работы с этим контрагентом ───
  //
  // Раньше этих ответов в системе не было нигде. Работает контрагент с НДС
  // или нет — галочку ставили заново в каждой заявке, и ставил её менеджер,
  // который про НДС не знает. Срок оплаты жил свободной строкой текста, из
  // которой нельзя посчитать ни одной даты. Оба ответа принадлежат
  // контрагенту, а не рейсу: договорились один раз — работает всегда.

  /// Работает ли контрагент с НДС.
  ///
  /// null — не выяснено, и это не то же самое, что «без НДС». Напечатать
  /// «без НДС» наугад в документе, который уходит с печатью, нельзя:
  /// пока ответа нет, платформа обязана спросить, а не догадываться.
  vatPayer Boolean?
  /// Ставка НДС этого контрагента: у разных стран и режимов она разная.
  vatRate  Decimal? @db.Decimal(5, 2)

  /// Когда мы выставляем счёт заказчику: AFTER_UNLOAD — по факту выгрузки,
  /// AFTER_ORIGINALS — когда придут оригиналы накладных, MONTHLY — раз в
  /// месяц одним счётом за все рейсы.
  invoiceTiming String?

  /// Отсрочка, которую мы дали ЗАКАЗЧИКУ: через сколько дней и от какого дня
  /// он обязан заплатить нам. Точка отсчёта: UNLOAD — от выгрузки,
  /// INVOICE — от даты счёта, ORIGINALS — от получения оригиналов накладных.
  customerPaymentDays Int?
  customerPaymentFrom String?

  /// Отсрочка, которую дал нам ПЕРЕВОЗЧИК: через сколько дней и от какого
  /// дня мы обязаны заплатить ему. Точки отсчёта те же. Именно это
  /// печатается в договоре-заявке — вместо прежних «15 календарных дней»,
  /// которые подставлялись вслепую.
  carrierPaymentDays Int?
  carrierPaymentFrom String?
}

// ... existing models ...

// ==================== PARTNERSHIPS ====================

enum PartnershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Partnership {
  id String @id @default(cuid())

  requesterId String
  requester   Company @relation("PartnershipRequester", fields: [requesterId], references: [id])

  recipientId String
  recipient   Company @relation("PartnershipRecipient", fields: [recipientId], references: [id])

  status PartnershipStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, recipientId])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String // Для Single Session Policy
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model Location {
  id      String @id @default(cuid())
  name    String // Название точки
  address String // Полный адрес одной строкой — он печатается в документах

  /// Координаты. Необязательны намеренно.
  ///
  /// Раньше без них адрес не сохранялся, а взять их было неоткуда, кроме
  /// геокодера. Кончились запросы к нему или он недоступен — и новый адрес
  /// завести нельзя, значит нельзя оформить рейс. Теперь адрес живёт и без
  /// точки: на карте его не видно и километры не считаются, но работа идёт.
  latitude  Float?
  longitude Float?

  /// Точку поставил человек руками на карте.
  ///
  /// Такие координаты дозапись не трогает: человек знает, где въезд на склад,
  /// а геокодер поставит точку на середину улицы.
  coordinatesManual Boolean @default(false)

  /// Когда последний раз искали координаты и не нашли. Нужно, чтобы список
  /// «адреса без координат» отличал «ещё не искали» от «искали, не нашлось».
  geocodeFailedAt DateTime?

  /// Части адреса, как их ввёл человек.
  ///
  /// Раньше адрес был одной строкой из подсказки геокодера. Без подсказок
  /// вводить было нечего — и незачем: система всё равно не понимала, где
  /// город, а где улица. Теперь части вводятся руками и из них же собирается
  /// строка адреса.
  country String?
  region  String?
  street  String?
  house   String?

  contactName  String?
  contactPhone String?
  city         String? // Город текстом — справочник только подсказывает
  cityId       String?
  cityRecord   City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  notes        String?
  emails       String? // Контактные email-адреса
  companyId    String? // ID привязанного контрагента
  company      Company? @relation("CompanyLocations", fields: [companyId], references: [id])
  createdAt    DateTime @default(now())

  // Кто создал
  createdById String?

  // Relations
  routePoints    OrderRoutePoint[]
  warehouseGates WarehouseGate[]
  emailLists     LocationEmailList[]

  originQuoteRequests      QuoteRequest[] @relation("OriginQuoteLocations")
  destinationQuoteRequests QuoteRequest[] @relation("DestinationQuoteLocations")

  @@index([latitude, longitude])
  @@index([cityId])
}

model Country {
  id               String   @id @default(cuid())
  name             String   @unique // e.g., "Kazakhstan"
  code             String   @unique // e.g., "KZ"
  externalProvider String?
  externalId       String?
  regions          Region[]
  cities           City[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([externalProvider, externalId])
}

model Region {
  id               String   @id @default(cuid())
  name             String // e.g., "Almaty Region"
  countryId        String
  country          Country  @relation(fields: [countryId], references: [id])
  externalProvider String?
  externalId       String?
  cities           City[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([countryId, name])
  @@unique([externalProvider, externalId])
}

model City {
  id               String  @id @default(cuid())
  name             String
  latitude         Float
  longitude        Float
  externalProvider String?
  externalId       String?

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  originTariffs      RouteTariff[] @relation("OriginTariffs")
  destinationTariffs RouteTariff[] @relation("DestinationTariffs")
  locations          Location[]

  originQuoteRequests      QuoteRequest[] @relation("OriginQuoteRequests")
  destinationQuoteRequests QuoteRequest[] @relation("DestinationQuoteRequests")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, regionId, name]) // Unique name per region/country
  @@unique([externalProvider, externalId])
}

model Order {
  id                      String                    @id @default(cuid())
  formedDocuments         OrderDocument[]           @relation("OrderDocuments")
  orderNumber             String                    @unique // Номер заявки
  status                  OrderStatus               @default(DRAFT)
  accountingDocumentLines AccountingDocumentLine[]
  accountingDocuments     AccountingDocumentOrder[]
  pendingStatus           OrderStatus?
  pendingStatusById       String?
  pendingStatusAt         DateTime?
  // Груз
  cargoDescription        String?
  cargoWeight             Float? // кг
  cargoVolume             Float? // м³
  cargoLength             Float? // Длина груза, м
  cargoWidth              Float? // Ширина груза, м
  cargoHeight             Float? // Высота груза, м
  palletCount             Int? // Количество палет — итог по составу ниже

  /// Состав паллет: [{ kind, length, width, count }].
  /// Список, а не одно число: в рейсе бывает вперемешку — например пять
  /// европаллет и десять финских. `palletCount` остаётся суммой, на него
  /// опираются карточка рейса, кабинет водителя и печатные формы.
  pallets        Json?
  /// Как грузят: задняя, боковая, верхняя. Сразу несколько — обычное дело.
  loadingTypes   String[]
  /// В чём груз: паллеты, мешки, коробки, биг-бэги, россыпью.
  packagingTypes String[]

  /// Количество грузовых мест. Не то же, что палеты: на одной палете едет
  /// десяток коробок, и в накладной считают именно места.
  placesCount Int?
  /// Можно ли ставить друг на друга. От этого зависит, влезет ли груз в
  /// машину: нештабелируемое считают по полу, а не по объёму.
  stackable   Boolean?
  /// Температурный режим, °C. Для рефрижератора это главное условие рейса.
  tempMin     Float?
  tempMax     Float?
  /// Опасный груз и его класс по ДОПОГ. Без этого перевозчик не поймёт,
  /// нужны ли допуск и знаки, а на посту это разворачивает машину.
  adr         Boolean?
  adrClass    String?
  /// Объявленная стоимость груза — от неё считают страховку и
  /// ответственность перевозчика.
  cargoValue  Float?

  cargoType     String? // Тип транспорта (Тент, Реф и т.д.)
  natureOfCargo String? // Характер груза (Сыпучие, Твердые и т.д.)
  requirements  String? // Особые требования

  // Участники
  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  driverId String?
  driver   User?   @relation("DriverOrders", fields: [driverId], references: [id])

  recipientId String?
  recipient   User?   @relation("RecipientOrders", fields: [recipientId], references: [id])

  // Если субподрядчик
  partnerId String?
  partner   Company? @relation("PartnerOrders", fields: [partnerId], references: [id])

  // Компания-заказчик
  customerCompanyId String?
  customerCompany   Company? @relation("CustomerCompanyOrders", fields: [customerCompanyId], references: [id])

  // Экспедитор (назначается заказчиком)
  forwarderId String?
  forwarder   Company? @relation("ForwarderOrders", fields: [forwarderId], references: [id])

  // Ответственный менеджер (кто создал/ведет)
  responsibleManagerId String?
  responsibleManager   User?   @relation("ManagerOrders", fields: [responsibleManagerId], references: [id])

  // Суб-экспедитор (назначенный основным экспедитором)
  subForwarderId    String?
  subForwarder      Company? @relation("SubForwarderOrders", fields: [subForwarderId], references: [id])
  subForwarderPrice Decimal? @db.Decimal(18, 2) // Цена для суб-экспедитора

  // Данные водителя от экспедитора (заполняет экспедитор)
  assignedDriverName    String? // ФИО водителя
  assignedDriverPhone   String? // Телефон водителя
  assignedDriverPlate   String? // Госномер авто (снимок на момент рейса)
  assignedDriverTrailer String? // Номер прицепа
  assignedAt            DateTime? // Когда назначен водитель

  // Секретная ссылка для водителя (веб вместо приложения). Уникальность
  // обеспечивается случайным 24-байтным токеном (без DB-constraint, чтобы
  // db push не требовал --accept-data-loss на существующей таблице).
  driverToken      String?
  // Последнее местоположение водителя (со страницы водителя)
  driverLat        Float?
  driverLng        Float?
  driverSpeed      Float?
  driverHeading    Float?
  driverLocationAt DateTime?

  // Фаза 3: ссылка на конкретную машину (актив). Nullable, пока не пишется существующей
  // логикой — текстовые поля assignedDriver* остаются снимком. Задел под историю/переиспользование.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Финансы
  customerPrice     Decimal?  @db.Decimal(18, 2) // Цена для клиента (видит клиент)
  customerPriceType PriceType @default(FIXED) // Тип цены (Всего, за км, за тонну)
  driverCost        Decimal?  @db.Decimal(18, 2) // Оплата водителю/перевозчику (скрыто от клиента)
  vatRate           Decimal   @default(0) @db.Decimal(5, 2)
  hasVat            Boolean   @default(false)
  executorVatRate   Decimal   @default(0) @db.Decimal(5, 2)
  executorHasVat    Boolean   @default(false)

  // Тариф по доп. соглашению (автоподстановка)
  appliedTariffId String?
  appliedTariff   RouteTariff? @relation(fields: [appliedTariffId], references: [id])

  /// Валюта тарифа КЛИЕНТА (сколько он платит нам).
  ///
  /// Тип колонки оставлен прежним (TEXT): сужать его до трёх символов
  /// значило бы менять существующую колонку, а миграции в этом проекте
  /// только добавляют. Длину держит проверка на входе.
  currency String @default("KZT")

  /// Валюта тарифа ПЕРЕВОЗЧИКА (сколько платим мы).
  ///
  /// Отдельная от клиентской намеренно: российский заказчик платит рублями,
  /// а казахстанский перевозчик хочет тенге — это обычный рейс, а не
  /// исключение. Пока валюты общие, «120 минус 100» ещё что-то значит; как
  /// только они разошлись, маржу можно считать только в учётной валюте.
  driverCostCurrency String @default("KZT") @db.VarChar(3)

  /// Те же суммы в учётной валюте компании — по курсам на `currencyRateDate`.
  ///
  /// Хранятся, а не считаются на лету: отчёты складывают тысячи заявок, и
  /// поход за курсом на каждую строку сделал бы их неподъёмными. Пересчёт
  /// происходит при сохранении заявки — то есть тогда же, когда меняются
  /// сами суммы.
  customerPriceBase Decimal?  @db.Decimal(18, 2)
  driverCostBase    Decimal?  @db.Decimal(18, 2)

  /// Валюта ставки суб-экспедитора и её пересчёт.
  ///
  /// Раньше эта ставка была единственной суммой заявки без своей валюты: она
  /// молча следовала за валютой заявки. Стоило перевести заявку в доллары —
  /// и ставка перевозчика, которую никто не трогал, становилась «столько же,
  /// но в долларах». Пусто означает «валюта заявки» — так понимались все
  /// заявки, заведённые до появления этой колонки.
  subForwarderPriceCurrency String?  @db.VarChar(3)
  subForwarderPriceBase     Decimal? @db.Decimal(20, 2)

  /// По курсам какого дня пересчитано. Обычно дата погрузки.
  currencyRateDate  DateTime? @db.Date

  // Подтверждение нами
  isConfirmed   Boolean   @default(false)
  confirmedAt   DateTime?
  confirmedById String?

  // Статус оплаты
  isCustomerPaid     Boolean   @default(false) // Заказчик оплатил нам
  customerPaidAt     DateTime? // Когда оплатил
  isDriverPaid       Boolean   @default(false) // Мы оплатили водителю / партнёру
  driverPaidAt       DateTime? // Когда оплатили
  isSubForwarderPaid Boolean   @default(false) // Мы оплатили суб-экспедитору
  subForwarderPaidAt DateTime? // Когда оплатили

  // --- Данные из Excel (Full List) ---

  // Финансы: Заказчик
  customerPaymentCondition String? // Условие оплаты (По факту, Отсрочка...)
  customerPaymentForm      String? // Форма оплаты (НДС, без НДС...)
  customerPaymentDate      DateTime? // Плановая дата оплаты

  // Финансы: Перевозчик
  driverPaymentCondition String?
  driverPaymentForm      String?
  driverPaymentDate      DateTime?

  // ─── Условия расчётов по рейсу ───
  //
  // Снимок условий из карточек контрагентов на момент рейса. Именно снимок:
  // договорённость с контрагентом могут поменять через полгода, а этот рейс
  // прошёл по прежним условиям, и документ по нему должен остаться прежним.
  //
  // Из этих чисел считаются `customerPaymentDate` и `driverPaymentDate` выше —
  // плановые даты платежей. До сих пор они пустовали, потому что условие
  // оплаты хранилось свободной строкой: посчитать по ней дату невозможно.
  customerPaymentDays Int?
  customerPaymentFrom String?
  carrierPaymentDays  Int?
  carrierPaymentFrom  String?

  /// Когда оригиналы накладных дошли до того, кто их ждёт.
  ///
  /// Половина отсрочек считается «через N дней с момента получения
  /// оригиналов». Число дней и точку отсчёта платформа знала и раньше, а
  /// самого события у неё не было — отметить, что оригиналы пришли, было
  /// негде. Поэтому по таким условиям плановая дата платежа не считалась
  /// вовсе, и «кому мы должны и когда» оставалось в голове у человека.
  ///
  /// Событий два, и путать их нельзя:
  ///   * `carrierOriginalsAt` — оригиналы пришли к НАМ от перевозчика; с
  ///     этого дня идёт срок, когда мы платим ему;
  ///   * `customerOriginalsAt` — оригиналы дошли до ЗАКАЗЧИКА; с этого дня
  ///     идёт срок, когда он платит нам.
  /// Между ними обычно несколько дней почты, и это разные деньги.
  carrierOriginalsAt  DateTime?
  customerOriginalsAt DateTime?

  /// Расчёты по рейсу проверены бухгалтером.
  ///
  /// Пока не проверены: договор-заявку можно только сформировать черновиком
  /// (без печати), счёт выставить нельзя, а контрагент на платформе видит
  /// рейс без налоговой части — «условия расчётов уточняются». Так менеджер
  /// не решает за бухгалтера, а бухгалтер не узнаёт о своей заявке от
  /// контрагента.
  ///
  /// Подтверждается само, когда в карточках сторон всё заполнено и ставки
  /// подставились из них: подтверждение — про исключения, а не про рутину.
  settlementsConfirmedAt   DateTime?
  settlementsConfirmedById String?

  // Документы и коды
  ttnNumber       String? // Номер ТТН
  /// Номер этой же перевозки в системе заказчика.
  ///
  /// Отдельно от `ttnNumber`: логисты вписывали чужой номер туда, потому что
  /// другого места не было, и в одной графе оказывались настоящая накладная и
  /// чужой идентификатор. Как эта графа называется на экране, задаёт сам
  /// заказчик — см. `Company.customerRefLabel`.
  customerRefNumber String?
  atiCodeCustomer String? // Код АТИ заказчика
  atiCodeCarrier  String? // Код АТИ перевозчика

  // Транспорт (уточнения для рейса)
  trailerNumber String? // Номер прицепа

  // Фактические данные
  actualWeight Float? // Вес факт
  actualVolume Float? // Объем факт

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  routePoints               OrderRoutePoint[]
  documents                 Document[]
  statusHistory             OrderStatusHistory[]
  gpsPoints                 GpsPoint[]
  problems                  OrderProblem[]
  warehouseQueue            WarehouseQueueItem?
  expenses                  Expense[]
  incomes                   Income[]
  bonuses                   Bonus[]
  payments                  Payment[]
  /// Доли платежей, разнесённых на эту заявку вместе с другими.
  paymentShares             PaymentOrderShare[]
  financeOperations         FinanceOperation[]
  assignees                 OrderAssignee[]
  responsibles              OrderResponsible[]
  changeLog                 OrderChangeLog[]
  proposedCustomerPrice     Decimal?             @db.Decimal(18, 2)
  proposedDriverCost        Decimal?             @db.Decimal(18, 2)
  proposedSubForwarderPrice Decimal?             @db.Decimal(18, 2)
  paymentProofs             OrderPaymentProof[]
  /// Запрос на расчёт, из которого выросла эта заявка.
  quoteRequest              QuoteRequest?        @relation("OrderQuoteRequest")

  @@index([status])
  @@index([customerId])
  @@index([driverId])
  @@index([createdAt])
  @@index([customerCompanyId, status])
  @@index([forwarderId, status])
  @@index([partnerId, status])
  @@index([responsibleManagerId])
  @@index([subForwarderId])
}

model OrderRoutePoint {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  pointType RoutePointType
  sequence  Int // Порядок маршрута (1, 2, 3...)

  expectedDate DateTime?
  notes        String?

  @@index([orderId])
  @@index([locationId])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status      OrderStatus
  comment     String?
  changedById String?
  changedAt   DateTime    @default(now())

  @@index([orderId])
}

model OrderProblem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  description  String
  reportedById String
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())

  @@index([orderId])
}

model Document {
  id       String       @id @default(cuid())
  type     DocumentType
  fileName String
  fileUrl  String // S3 URL
  fileSize Int
  mimeType String

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  /// Кто приложил файл из кабинета.
  ///
  /// Необязательно: файл может прийти от контрагента по публичной ссылке
  /// на отчёт — учётной записи у него нет вовсе. Тогда автор записан ниже,
  /// организацией, и подписывать такой файл именем случайного нашего
  /// сотрудника было бы враньём в документообороте.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  /// Файл прислал контрагент по ссылке на отчёт.
  uploadedByCounterpartyId String?
  uploadedByCounterparty   Company? @relation("DocumentsFromCounterparty", fields: [uploadedByCounterpartyId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([type])
}

model GpsPoint {
  id       String @id @default(cuid())
  driverId String
  driver   User   @relation(fields: [driverId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  latitude  Float
  longitude Float
  accuracy  Float?
  speed     Float? // км/ч
  heading   Float? // направление

  recordedAt DateTime
  receivedAt DateTime @default(now())

  @@index([driverId, recordedAt])
  @@index([orderId])
}

// ==================== WAREHOUSE ====================

model WarehouseGate {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  gateNumber  String // Номер ворот/рампы
  isAvailable Boolean @default(true)

  queueItems WarehouseQueueItem[]

  @@unique([locationId, gateNumber])
}

model WarehouseQueueItem {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  gateId String?
  gate   WarehouseGate? @relation(fields: [gateId], references: [id])

  arrivedAt   DateTime  @default(now())
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  instructions String? // "Заезжайте на ворота 3"

  @@index([gateId])
}

// ==================== CARGO TYPES ====================

model CargoCategory {
  id        String      @id @default(cuid())
  name      String      @unique // Название категории
  sortOrder Int         @default(0)
  types     CargoType[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CargoType {
  id         String        @id @default(cuid())
  name       String // Название типа
  categoryId String
  category   CargoCategory @relation(fields: [categoryId], references: [id])
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId])
}

// ==================== CONTRACTS & TARIFFS ====================

model Contract {
  id             String @id @default(cuid())
  contractNumber String // Номер договора

  // Стороны
  customerCompanyId   String
  customerCompany     Company              @relation("ContractCustomer", fields: [customerCompanyId], references: [id])
  accountingDocuments AccountingDocument[]

  forwarderCompanyId String
  forwarderCompany   Company @relation("ContractForwarder", fields: [forwarderCompanyId], references: [id])

  status    ContractStatus @default(DRAFT)
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  content   Json? // Содержимое: массив статей [{title, paragraphs: [{number, text}]}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreements SupplementaryAgreement[]

  @@unique([customerCompanyId, forwarderCompanyId, contractNumber])
  @@index([customerCompanyId])
  @@index([forwarderCompanyId])
  @@index([status])
}

model SupplementaryAgreement {
  id              String @id @default(cuid())
  agreementNumber String // Номер доп. соглашения

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  status     AgreementStatus @default(DRAFT)
  proposedBy String          @default("FORWARDER") // "FORWARDER" или "CUSTOMER"
  validFrom  DateTime?
  validTo    DateTime?
  notes      String?

  // Кто создал
  createdById     String?
  // Кто утвердил/отклонил
  approvedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tariffs RouteTariff[]

  @@index([contractId])
  @@index([status])
}

model RouteTariff {
  id String @id @default(cuid())

  agreementId String
  agreement   SupplementaryAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  originCityId      String
  originCity        City   @relation("OriginTariffs", fields: [originCityId], references: [id])
  destinationCityId String
  destinationCity   City   @relation("DestinationTariffs", fields: [destinationCityId], references: [id])

  price       Decimal   @db.Decimal(18, 2) // Стоимость
  priceType   PriceType @default(FIXED)
  vehicleType String? // Тип кузова (опционально)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[] // Заявки по этому тарифу

  @@index([agreementId])
  @@index([originCityId, destinationCityId])
}

// ==================== ACCOUNTING ====================

model Expense {
  id String @id @default(cuid())

  companyId   String
  date        DateTime
  category    String // fuel, repair, salary, insurance, tax, rent, communication, office, penalties, other
  description String
  amount      Decimal  @db.Decimal(18, 2) // Сумма в тенге
  note        String?

  // Привязка к заявке (опционально)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Касса / расчётный счёт, с которого ушли деньги (опционально)
  accountId String?
  account   FinanceAccount? @relation("AccountExpenses", fields: [accountId], references: [id], onDelete: SetNull)

  createdById String? // Кто создал

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([companyId])
  @@index([companyId, date])
  @@index([category])
  @@index([orderId])
  @@index([accountId])
}

model Income {
  id String @id @default(cuid())

  companyId   String
  date        DateTime
  category    String // order_payment, prepayment, refund, other
  description String
  amount      Decimal  @db.Decimal(18, 2) // Сумма в тенге
  note        String?

  // Привязка к заявке (опционально)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Касса / расчётный счёт, на который пришли деньги (опционально)
  accountId String?
  account   FinanceAccount? @relation("AccountIncomes", fields: [accountId], references: [id], onDelete: SetNull)

  createdById String? // Кто создал

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([companyId])
  @@index([companyId, date])
  @@index([category])
  @@index([orderId])
  @@index([accountId])
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK
  CARD
  OTHER
}

model Payment {
  id                  String                        @id @default(cuid())
  companyId           String
  company             Company                       @relation("CompanyPayments", fields: [companyId], references: [id], onDelete: Cascade)
  orderId             String?
  order               Order?                        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  counterpartyId      String?
  counterparty        Company?                      @relation("CounterpartyPayments", fields: [counterpartyId], references: [id], onDelete: SetNull)
  direction           PaymentDirection
  amount              Decimal                       @db.Decimal(18, 2)

  /// Валюта платежа — та, в которой деньги реально пришли или ушли.
  /// Курс на дату платежа хранится здесь же: завтра он другой, но этот
  /// платёж обязан остаться вчерашним, иначе отчёт за прошлый месяц
  /// начнёт меняться сам по себе.
  currency         String    @default("KZT")
  exchangeRate     Decimal?  @db.Decimal(18, 6)
  exchangeRateDate DateTime? @db.Date
  /// Сумма платежа в учётной валюте по этому курсу.
  amountBase       Decimal?  @db.Decimal(20, 2)

  date                DateTime
  method              PaymentMethod                 @default(BANK)
  note                String?
  createdById         String?
  isDeleted           Boolean                       @default(false)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  accountId           String?
  account             FinanceAccount?               @relation("AccountPayments", fields: [accountId], references: [id], onDelete: SetNull)
  categoryId          String?
  category            FinanceCategory?              @relation("CategoryPayments", fields: [categoryId], references: [id], onDelete: SetNull)
  documentAllocations AccountingPaymentAllocation[]

  /// По каким заявкам разошёлся этот платёж.
  ///
  /// Заполняется, когда одним поступлением закрывают сразу несколько
  /// заявок — так платят заказчики: один перевод на два десятка рейсов.
  /// Тогда `orderId` пуст, а доли лежат здесь: иначе пришлось бы резать
  /// банковский платёж на два десятка записей, и выписка перестала бы
  /// сходиться со списком платежей построчно.
  orderShares         PaymentOrderShare[]

  /// Возврат денег по ранее принятому платежу (сторно).
  /// Хранится отдельным платежом обратного направления со ссылкой на
  /// исходный: иначе вернуть деньги можно было бы только удалив платёж,
  /// а это стирает историю и ломает акт сверки.
  refundOfId String?
  refundOf   Payment?  @relation("PaymentRefunds", fields: [refundOfId], references: [id], onDelete: Restrict)
  refunds    Payment[] @relation("PaymentRefunds")

  @@index([companyId, date])
  @@index([companyId, currency])
  @@index([orderId])
  @@index([direction])
  @@index([accountId])
  @@index([categoryId])
  @@index([refundOfId])
}

enum AccountKind {
  CASH
  BANK
}

model FinanceAccount {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation("CompanyFinanceAccounts", fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  kind      AccountKind
  isDefault Boolean     @default(false)
  isActive  Boolean     @default(true)
  /// Валюта счёта или кассы. Один счёт — одна валюта: валютный счёт в банке
  /// физически хранит доллары, и общий остаток с тенговым счётом у него не
  /// складывается — это разные деньги.
  currency  String      @default("KZT")

  // Печатные реквизиты счёта (заполняются для kind = BANK).
  // Нужны, чтобы в счёте на оплату печатался тот банк, с которого его
  // выставили: у компании может быть несколько расчётных счетов, а в
  // карточке организации хранится только один комплект реквизитов.
  iban                String?
  bankName            String?
  bankBic             String?
  kbe                 String?
  openingBalance      Decimal              @default(0) @db.Decimal(18, 2) // Начальный остаток (ввод остатков)
  openingDate         DateTime? // Дата, на которую введён начальный остаток
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  payments            Payment[]            @relation("AccountPayments")
  incomes             Income[]             @relation("AccountIncomes")
  expenses            Expense[]            @relation("AccountExpenses")
  financeOperations   FinanceOperation[]   @relation("AccountFinanceOperations")
  accountingDocuments AccountingDocument[] @relation("AccountingDocumentBankAccount")
  revaluationLines    CurrencyRevaluationLine[]

  @@unique([companyId, name, kind])
  @@index([companyId])
}

enum CostType {
  PER_ORDER // По заявке — себестоимость рейса (режет маржу заявки)
  PER_VEHICLE // По машине — расход конкретного ТС
  GENERAL // Общехозяйственный — общий расход фирмы
}

model FinanceCategory {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation("CompanyFinanceCategories", fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  direction         PaymentDirection
  costType          CostType? // Тип статьи затрат (только для расходных, direction=OUT)
  isSystem          Boolean            @default(false)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payments          Payment[]          @relation("CategoryPayments")
  financeOperations FinanceOperation[] @relation("CategoryFinanceOperations")

  @@unique([companyId, name, direction])
  @@index([companyId])
}

// ==================== ФАЗА 1 (аудит M-8): единая модель финансовых операций ====================
// Payment/Income/Expense фактически описывают одно и то же (движение денег компании),
// но независимыми моделями с разными наборами полей — это создаёт риск задвоения
// доходов/расходов в отчётах (см. аудит) и не даёт единой ленты операций.
//
// Как и в случае с Person/Affiliation (Фаза 1 мультикомпанийной архитектуры выше),
// объединение делается поэтапно: на этой фазе FinanceOperation ЗАПОЛНЯЕТСЯ бэкфиллом
// из Payment/Income/Expense (см. prisma/backfill-finance-operations.js) и НЕ читается
// существующей логикой — ничего не ломает и не меняет поведение отчётов. Переключение
// чтения/записи на неё — отдельная будущая фаза, требующая синхронной правки ~13 мест
// в api (в первую очередь financial-reports.service.ts) и web (страницы accounting/*).
//
// sourceId — id исходной записи в Payment/Income/Expense, чтобы backfill был проверяем
// и обратим (сверка 1:1, как PersonMerge позволяет проверить/откатить слияние личностей).
enum FinanceOperationSource {
  PAYMENT
  INCOME
  EXPENSE
}

model FinanceOperation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("CompanyFinanceOperations", fields: [companyId], references: [id], onDelete: Cascade)

  source   FinanceOperationSource
  sourceId String // id исходной записи (Payment/Income/Expense.id)

  direction PaymentDirection // IN|OUT; для Income всегда IN, для Expense всегда OUT
  amount    Decimal          @db.Decimal(18, 2)
  date      DateTime

  // Категория: у Payment — ссылка на FinanceCategory, у Income/Expense — свободный текст.
  // Храним оба варианта, чтобы бэкфилл не терял данные ни одного источника.
  categoryId    String?
  category      FinanceCategory? @relation("CategoryFinanceOperations", fields: [categoryId], references: [id], onDelete: SetNull)
  categoryLabel String? // свободный текст категории (из Income.category/Expense.category)

  description String? // у Income/Expense обязательное поле, у Payment — нет
  note        String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  counterpartyId String? // только у Payment
  counterparty   Company? @relation("CounterpartyFinanceOperations", fields: [counterpartyId], references: [id], onDelete: SetNull)

  accountId String?
  account   FinanceAccount? @relation("AccountFinanceOperations", fields: [accountId], references: [id], onDelete: SetNull)

  method PaymentMethod? // только у Payment

  createdById String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([companyId, date])
  @@index([companyId, isDeleted])
  @@index([orderId])
  @@index([accountId])
  @@index([categoryId])
}

// ==================== ТМЦ (товарно-материальные ценности) ====================

enum StockMoveType {
  RECEIPT // Поступление товаров и услуг
  TRANSFER // Перемещение между складами
  WRITEOFF // Списание материалов
}

model NomenclatureItem {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation("CompanyNomenclature", fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  unit      String          @default("шт")
  sku       String? // Артикул
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  lines     StockMoveLine[]

  @@unique([companyId, name])
  @@index([companyId])
}

model StockWarehouse {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation("CompanyWarehouses", fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  movesFrom StockMove[] @relation("MoveWarehouse")
  movesTo   StockMove[] @relation("MoveToWarehouse")

  @@unique([companyId, name])
  @@index([companyId])
}

model StockMove {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation("CompanyStockMoves", fields: [companyId], references: [id], onDelete: Cascade)
  type            StockMoveType
  number          String
  date            DateTime
  warehouseId     String
  warehouse       StockWarehouse  @relation("MoveWarehouse", fields: [warehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     StockWarehouse? @relation("MoveToWarehouse", fields: [toWarehouseId], references: [id])
  counterparty    String? // Поставщик (для поступления) — свободный текст
  expenseCategory String? // Статья затрат для списания (попадает в ПиУ / расходы по статьям)
  note            String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lines           StockMoveLine[]

  @@index([companyId, type])
  @@index([companyId, date])
}

model StockMoveLine {
  id             String           @id @default(cuid())
  moveId         String
  move           StockMove        @relation(fields: [moveId], references: [id], onDelete: Cascade)
  nomenclatureId String
  nomenclature   NomenclatureItem @relation(fields: [nomenclatureId], references: [id])
  quantity       Decimal          @db.Decimal(18, 3)
  price          Decimal?         @db.Decimal(18, 2)
  amount         Decimal?         @db.Decimal(18, 2)

  @@index([moveId])
  @@index([nomenclatureId])
}

// Настройка нумерации заявок (как в 1С: префикс + ведущие нули + стартовый номер)
model OrderNumbering {
  id         String   @id @default(cuid())
  companyId  String   @unique
  company    Company  @relation("CompanyOrderNumbering", fields: [companyId], references: [id], onDelete: Cascade)
  prefix     String   @default("") // Префикс перед номером (может быть пустым)
  padding    Int      @default(9) // Длина числовой части (ведущие нули)
  nextNumber Int      @default(1) // Следующий номер, который будет присвоен
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==================== ЗАПРОСЫ НА РАСЧЁТ ====================

/// Что стало с запросом. Ровно четыре состояния — так их назвал заказчик:
/// новый, в работе, согласован, не согласован. Пятого не заводим:
/// «отправили КП» — это не отдельное состояние, а момент, когда появилась
/// цена, и он виден по заполненным ценам и дате.
enum QuoteRequestStatus {
  NEW // Новый — пришёл, ещё не считали
  IN_PROGRESS // В работе — ищем машину, посчитали, отправили цену
  APPROVED // Согласован — клиент подтвердил, дальше заявка
  REJECTED // Не согласован — клиент отказался
}

/// Запрос клиента на расчёт стоимости перевозки.
///
/// Это то, что происходит ДО заявки. Клиент пишет: «завтра отгружаем,
/// Шымкент — Алматы, 20 тонн, 86 кубов, посчитайте». Мы ищем машину,
/// называем цену, он соглашается или нет.
///
/// Зачем хранить. Отказы нигде не оставались, и через два дня тот же
/// клиент спрашивал тот же маршрут — а менеджер уже не помнил ни что
/// предлагал, ни почём нашёл машину. Называли ту же цену, на которую уже
/// отказали. Здесь этот случай запоминается целиком: обе цены и исход.
///
/// Маршрут хранится городами, а не адресами, намеренно: похожий запрос
/// ищется именно по направлению. Склад у каждого клиента свой, а
/// «Шымкент — Алматы» общий, и по адресам совпадений не было бы.
model QuoteRequest {
  id            String @id @default(cuid())
  requestNumber String @unique

  /// Наша организация — чей это запрос.
  companyId String
  company   Company @relation("CompanyQuoteRequests", fields: [companyId], references: [id], onDelete: Cascade)

  /// Клиент, который просит расчёт. Обязателен: запрос всегда чей-то, и
  /// вся память строится по паре «клиент + маршрут».
  customerCompanyId String
  customerCompany   Company @relation("CustomerQuoteRequests", fields: [customerCompanyId], references: [id])

  /// Города маршрута.
  ///
  /// Пишутся текстом, справочник только подсказывает. Из-за выбора строго
  /// из списка компания не смогла завести запрос на Мынарал: посёлка нет в
  /// справочнике, потому что справочник наполняется геокодером.
  ///
  /// Поэтому полей три на каждый конец. `...CityName` — как написал
  /// человек, это и показывается. `...CityId` — ссылка на справочник, если
  /// город удалось узнать: по ней работают годовые тарифы и подстановка в
  /// заявку. `...CityKey` — приведённое написание, по нему сходится память
  /// по направлению: «Шымкент», «г. Шымкент» и «Чимкент» дают один ключ.
  originCityId      String?
  originCity        City?   @relation("OriginQuoteRequests", fields: [originCityId], references: [id])
  originCityName    String?
  originCityKey     String?
  destinationCityId String?
  destinationCity   City?   @relation("DestinationQuoteRequests", fields: [destinationCityId], references: [id])
  destinationCityName String?
  destinationCityKey  String?

  /// Точные адреса погрузки и выгрузки, если клиент их уже назвал.
  ///
  /// Города и адреса нужны оба и для разного. По городам ищется история:
  /// склад у каждого клиента свой, и по адресам похожий случай не нашёлся
  /// бы никогда. Адреса переносятся в заявку, когда клиент согласовал.
  ///
  /// Ссылка на справочник — если адрес там уже есть: тогда заявка получает
  /// точку маршрута без ручного ввода. Текстом — если клиент прислал адрес,
  /// которого в справочнике ещё нет; терять его до заведения карточки
  /// нельзя, иначе он останется в переписке.
  originLocationId      String?
  originLocation        Location? @relation("OriginQuoteLocations", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocationId String?
  destinationLocation   Location? @relation("DestinationQuoteLocations", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  originAddress         String?
  destinationAddress    String?

  /// Когда груз готов к отгрузке.
  readyDate        DateTime?
  cargoDescription String?
  /// Характер груза: напитки, стройматериалы, продукты.
  natureOfCargo    String?
  /// Тип кузова: тент, рефрижератор, борт.
  cargoType        String?
  /// Вес в килограммах — как в заявке. В интерфейсе показываем тоннами,
  /// потому что клиенты говорят «20 тонн», но храним в тех же единицах,
  /// что и заявка: из запроса потом делается заявка, и пересчёт на
  /// границе — источник ошибок в цене.
  cargoWeight      Float?
  cargoVolume      Float?

  /// Сколько паллет. В грузоперевозках по Казахстану считают именно ими:
  /// «две паллеты Астана — Алматы» — обычная формулировка запроса, а вес
  /// клиент часто называет приблизительно или не называет вовсе. Поле
  /// переносится в заявку при согласовании, поэтому единица та же.
  palletCount      Int?

  /// Вид паллеты: ключ из `PALLET_KINDS` — EUR, FIN, AMERICAN, HALF,
  /// CUSTOM. Одного вида хватает: запрос — это разговор до заявки, клиент
  /// называет «две европаллеты», а не смешанный состав. Размеры не храним,
  /// они однозначно выводятся из вида; смешанный состав появляется уже в
  /// заявке, где под него есть список.
  palletKind       String?

  /// Почём нашли машину. Именно это менеджер забывает первым делом.
  carrierCost   Decimal? @db.Decimal(18, 2)
  /// Что предложили клиенту.
  customerPrice Decimal? @db.Decimal(18, 2)
  currency      String   @default("KZT")
  /// Когда назвали цену.
  quotedAt      DateTime?
  quotedById    String?

  status          QuoteRequestStatus @default(NEW)
  /// Почему клиент отказался — словами менеджера. Без причины отказ
  /// бесполезен: «дорого» и «нашли раньше» требуют разных решений.
  rejectionReason String?
  decidedAt       DateTime?
  notes           String?

  createdById String?

  /// Заявка, в которую превратился согласованный запрос.
  orderId String? @unique
  order   Order?  @relation("OrderQuoteRequest", fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([customerCompanyId, originCityId, destinationCityId])
  @@index([companyId, originCityId, destinationCityId])
  /// Память по направлению ищет именно так: направление всей компании,
  /// клиент — уже потом, вторым разрезом.
  @@index([companyId, originCityKey, destinationCityKey])
  @@index([createdAt])
}

/// Нумерация запросов — по одной настройке на организацию, как у заявок.
model QuoteRequestNumbering {
  id         String   @id @default(cuid())
  companyId  String   @unique
  company    Company  @relation("CompanyQuoteRequestNumbering", fields: [companyId], references: [id], onDelete: Cascade)
  prefix     String   @default("ЗПР-")
  padding    Int      @default(5)
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Универсальные справочники (условия/формы оплаты, формы собственности, банки)
enum DictionaryKind {
  PAYMENT_CONDITION // Условия оплаты (для заявок)
  PAYMENT_FORM // Формы оплаты (для заявок)
  OWNERSHIP_TYPE // Формы собственности контрагентов
  BANK // Банки
}

model DictionaryItem {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation("CompanyDictionaries", fields: [companyId], references: [id], onDelete: Cascade)
  kind      DictionaryKind
  name      String
  code      String? // Доп. код: БИК банка и т.п.
  isActive  Boolean        @default(true)
  isDefault Boolean        @default(false)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([companyId, kind, name])
  @@index([companyId, kind])
}

// Справочник наименований услуг (для актов выполненных работ и счетов)
model ServiceCatalogItem {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation("CompanyServiceCatalog", fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  unit      String   @default("услуга") // Единица измерения: услуга, рейс, км, т и т.д.
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false) // Подставляется в акт по умолчанию
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

// Начальные долги контрагентов на дату старта учёта (ввод остатков → заказчики/перевозчики)
/// Публичная ссылка на отчёт по взаиморасчётам с контрагентом.
///
/// Раньше ссылка жила только в Redis: перезапуск кэша убивал все ссылки
/// разом, отозвать конкретную было нечем, а список выданных нигде не
/// хранился. Здесь она — обычная запись: срок действия честный, отзыв
/// возможен, и видно кому что отправляли.
model SharedReportLink {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("CompanySharedReports", fields: [companyId], references: [id], onDelete: Cascade)

  /// Контрагент, по которому собран отчёт.
  counterpartyId String
  counterparty   Company @relation("CounterpartySharedReports", fields: [counterpartyId], references: [id], onDelete: Cascade)

  /// Наша роль в этих сделках: заказчик мы или исполнитель.
  ourRole String

  token     String    @unique @default(uuid())
  expiresAt DateTime
  /// Отозвана вручную — ссылка перестаёт работать раньше срока.
  revokedAt DateTime?

  /// Кому отправляли — для журнала выданных ссылок.
  sentToEmail String?

  /// Отпечаток посещений: сколько раз открывали и когда в последний раз.
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  createdById String
  createdBy   User     @relation("CreatedSharedReports", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  /// Счета, выставленные контрагентом по этой ссылке.
  invoices AccountingDocument[] @relation("SharedReportInvoices")

  @@index([companyId, createdAt])
  @@index([companyId, counterpartyId])
}

model CounterpartyOpeningBalance {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation("CompanyCounterpartyOpenings", fields: [companyId], references: [id], onDelete: Cascade)
  counterpartyId    String
  counterparty      Company   @relation("CounterpartyOpenings", fields: [counterpartyId], references: [id], onDelete: Cascade)
  openingReceivable Decimal   @default(0) @db.Decimal(18, 2) // Они нам должны на дату начала
  openingPayable    Decimal   @default(0) @db.Decimal(18, 2) // Мы им должны на дату начала
  openingDate       DateTime? // Дата, на которую введён начальный долг
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, counterpartyId])
  @@index([companyId])
}

model ClosedPeriod {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year       Int
  month      Int // 1-12
  closedById String
  closedBy   User     @relation(fields: [closedById], references: [id])
  closedAt   DateTime @default(now())

  @@unique([companyId, year, month])
  @@index([companyId])
}

// ==================== BONUSES ====================

model Bonus {
  id      String @id @default(cuid())
  userId  String // Менеджер
  user    User   @relation(fields: [userId], references: [id])
  orderId String // Заявка-источник
  order   Order  @relation(fields: [orderId], references: [id])

  amount     Decimal  @db.Decimal(18, 2) // Сумма бонуса
  type       String   @default("MARGIN_PERCENT") // MARGIN_PERCENT | FIXED
  percentage Decimal? @db.Decimal(5, 2) // Процент от маржи
  status     String   @default("PENDING") // PENDING | APPROVED | PAID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
}

// ==================== INVITATIONS ====================

model Invitation {
  id               String      @id @default(cuid())
  email            String
  role             UserRole
  position         String? // Должность/роль
  companyId        String
  token            String      @unique
  permissions      String[]    @default([])
  // Дополнительные организации, в которые сотрудник получит доступ при принятии
  // приглашения (мультикомпания). Основная — companyId. По умолчанию — все компании владельца.
  sharedCompanyIds String[]    @default([])
  isUsed           Boolean     @default(false)
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([token])
  @@index([departmentId])
}

// ==================== ORDER ASSIGNEES & CHANGE LOG ====================

model OrderAssignee {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("OrderAssignees", fields: [userId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([orderId, userId])
  @@index([orderId])
  @@index([userId])
}

model OrderChangeLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("OrderChangeLogs", fields: [userId], references: [id])
  action    String // "assigned", "unassigned", "updated", "status_changed", "driver_assigned", etc.
  details   String? // Human-readable description
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Department {
  id        String  @id @default(cuid())
  name      String
  icon      String? // Иконка отдела (например, "TruckOutlined")
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments     Department[] @relation("DepartmentHierarchy")

  users       User[]
  invitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([parentDepartmentId])
