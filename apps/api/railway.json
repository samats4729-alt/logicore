{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "preDeployCommand": [
            "pnpm prisma:deploy"
        ],
        "startCommand": "pnpm start:prod",
        "healthcheckPath": "/monitoring/health",
        "healthcheckTimeout": 120,
        "overlapSeconds": "20",
        "drainingSeconds": "10",
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
