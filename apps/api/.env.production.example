# ========================================
# Railway Environment Variables Template
# Copy these to your Railway service settings
# ========================================

# Database (Railway Postgres addon)
DATABASE_URL=postgresql://user:password@host:5432/railway

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Redis (Railway Redis addon) - OPTIONAL
# REDIS_URL=redis://default:password@host:6379

# Admin credentials
ADMIN_EMAIL=admin@logicore.kz
ADMIN_PASSWORD=securepassword123

# API Port (Railway sets this automatically)
PORT=3001

# CORS Origins (your frontend URL)
CORS_ORIGINS=https://your-web-app.railway.app

# Node environment
NODE_ENV=production

# Оплата подписки картой — FreedomPay. Ключ берётся в кабинете магазина и
# задаётся только здесь, в переменных Railway: в репозиторий он не попадает.
FREEDOMPAY_MERCHANT_ID=560000
FREEDOMPAY_SECRET_KEY=your-freedompay-secret-key
FREEDOMPAY_API_URL=https://api.freedompay.money
# «1» пока магазин в тестовом режиме, потом убрать
FREEDOMPAY_TESTING_MODE=1
# Свой адрес снаружи: на него FreedomPay присылает результат оплаты
API_PUBLIC_URL=https://your-api.railway.app
# Адрес кабинета: туда возвращается человек после оплаты
FRONTEND_URL=https://your-web-app.railway.app
