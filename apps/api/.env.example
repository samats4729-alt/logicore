# Database
DATABASE_URL="postgresql://logcomp:logcomp_secret@localhost:5433/logcomp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
# Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS"
JWT_EXPIRES_IN="7d"

# SMS Provider - SMSC.kz
SMSC_LOGIN="your_smsc_login"
SMSC_PASSWORD="your_smsc_password"
SMSC_SENDER="LogComp"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
S3_BUCKET="logcomp-documents"

# Google Auth
GOOGLE_CLIENT_ID="your-google-client-id"

# Telegram — уведомления владельцу об обращениях пользователей.
# Токен берётся у @BotFather, chat id — у @userinfobot (для группы или канала
# он отрицательный). Пока обе переменные пустые, обращение всё равно
# сохраняется в админке, просто не приходит в мессенджер.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Бот владельца: подтверждать компании и смотреть сводку прямо из переписки.
# Работает на том же токене, что и уведомления выше.
#
#   TELEGRAM_ADMIN_IDS      — кому можно, через запятую. Числовые id, не @имена.
#                             Своего не знаете — оставьте пусто, напишите боту,
#                             и он ответит вашим номером.
#   TELEGRAM_ADMIN_EMAIL    — почта администратора платформы, под которым в
#                             истории компании запишется решение. Не задана —
#                             бот откажется подтверждать: в журнале должно
#                             стоять имя человека, а не «бот».
#   TELEGRAM_WEBHOOK_SECRET — пароль, которым Telegram подписывает обновления.
#                             Длинная случайная строка ТОЛЬКО из латиницы,
#                             цифр, дефиса и подчёркивания: пароль едет в
#                             заголовке HTTP, и кириллица в нём портится по
#                             дороге — бот перестанет принимать что-либо.
#                             Пока пусто — бот не принимает ничего.
#
# После заполнения один раз подписать бота на обновления (см. AGENTS.md):
#   curl -s "https://api.telegram.org/bot<ТОКЕН>/setWebhook" \
#     -d "url=https://<адрес-api>/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_ADMIN_IDS=""
TELEGRAM_ADMIN_EMAIL=""
TELEGRAM_WEBHOOK_SECRET=""

# Map & Geocoding
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"
NEXT_PUBLIC_2GIS_API_KEY="your-2gis-api-key"

# App
PORT=3001
NODE_ENV=development

# Оплата подписки картой — FreedomPay.
#
#   FREEDOMPAY_MERCHANT_ID   номер магазина из кабинета FreedomPay
#   FREEDOMPAY_SECRET_KEY    секретный ключ для API (не для скриптов!). Им
#                            подписывается каждое сообщение в обе стороны, и
#                            проверка подписи на входящем «оплачено» —
#                            единственный замок на открытом обработчике.
#   FREEDOMPAY_API_URL       адрес шлюза; по умолчанию боевой
#   FREEDOMPAY_TESTING_MODE  «1», пока магазин в тестовом режиме
#   API_PUBLIC_URL           наш собственный адрес снаружи. На него шлюз
#                            присылает результат оплаты, поэтому localhost
#                            тут не годится: оплата пройдёт, а подписка нет.
#
# Пока номер магазина, ключ или API_PUBLIC_URL пустые, кнопка «Оплатить
# картой» в кабинете не показывается вовсе — остаётся оплата по счёту.
#
# В кабинете FreedomPay адреса обработчиков указывать не нужно: они уходят
# в каждом запросе. Нужен только сам магазин в рабочем состоянии.
FREEDOMPAY_MERCHANT_ID=""
FREEDOMPAY_SECRET_KEY=""
FREEDOMPAY_API_URL="https://api.freedompay.kz"
FREEDOMPAY_TESTING_MODE="1"
API_PUBLIC_URL=""

# ---- Биржа грузов ----
# Пока переменной нет или в ней не "true", биржи на сервере нет: ни вкладки
# в кабинете, ни адресов. Биржа строится в отдельной ветке; на рабочем
# сервере переменную не ставить, пока владелец не скажет включать.
EXCHANGE_ENABLED=""

# ---- Push-уведомления водителям (Expo) ----
# Сервер шлёт их через бесплатный сервис Expo; ключей Firebase серверу не
# нужно — ключ лежит в настройках проекта на expo.dev. Переменные ниже
# необязательны: без них всё работает.
#   EXPO_ACCESS_TOKEN — только если в проекте на expo.dev включена защита
#                       отправки («Enhanced Security for Push Notifications»).
#   PUSH_DISABLED     — "true": не слать вовсе (только запись в журнал).
#   EXPO_PUSH_URL     — другой адрес вместо сервиса Expo; для проверки на стенде.
EXPO_ACCESS_TOKEN=""
PUSH_DISABLED=""
