# Database
DATABASE_URL="postgresql://logcomp:logcomp_secret@localhost:5433/logcomp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
# Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS"
JWT_EXPIRES_IN="7d"

# SMS Provider - SMSC.kz
SMSC_LOGIN="your_smsc_login"
SMSC_PASSWORD="your_smsc_password"
SMSC_SENDER="LogComp"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
S3_BUCKET="logcomp-documents"

# Google Auth
GOOGLE_CLIENT_ID="your-google-client-id"

# Telegram — уведомления владельцу об обращениях пользователей.
# Токен берётся у @BotFather, chat id — у @userinfobot (для группы или канала
# он отрицательный). Пока обе переменные пустые, обращение всё равно
# сохраняется в админке, просто не приходит в мессенджер.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Бот владельца: подтверждать компании и смотреть сводку прямо из переписки.
# Работает на том же токене, что и уведомления выше.
#
#   TELEGRAM_ADMIN_IDS      — кому можно, через запятую. Числовые id, не @имена.
#                             Своего не знаете — оставьте пусто, напишите боту,
#                             и он ответит вашим номером.
#   TELEGRAM_ADMIN_EMAIL    — почта администратора платформы, под которым в
#                             истории компании запишется решение. Не задана —
#                             бот откажется подтверждать: в журнале должно
#                             стоять имя человека, а не «бот».
#   TELEGRAM_WEBHOOK_SECRET — пароль, которым Telegram подписывает обновления.
#                             Длинная случайная строка ТОЛЬКО из латиницы,
#                             цифр, дефиса и подчёркивания: пароль едет в
#                             заголовке HTTP, и кириллица в нём портится по
#                             дороге — бот перестанет принимать что-либо.
#                             Пока пусто — бот не принимает ничего.
#
# После заполнения один раз подписать бота на обновления (см. AGENTS.md):
#   curl -s "https://api.telegram.org/bot<ТОКЕН>/setWebhook" \
#     -d "url=https://<адрес-api>/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_ADMIN_IDS=""
TELEGRAM_ADMIN_EMAIL=""
TELEGRAM_WEBHOOK_SECRET=""

# Map & Geocoding
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"
NEXT_PUBLIC_2GIS_API_KEY="your-2gis-api-key"

# App
PORT=3001
NODE_ENV=development
