{
  "expo": {
    "name": "LogiCore Водитель",
    "slug": "logcomp-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "logcomp",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B89C6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.logcomp.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Приложение использует геолокацию для отслеживания рейса",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Геолокация нужна для отслеживания вашего маршрута в фоновом режиме",
        "NSLocationAlwaysUsageDescription": "Геолокация нужна для отслеживания вашего маршрута в фоновом режиме",
        "NSCameraUsageDescription": "Камера нужна, чтобы сфотографировать документы",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "kz.logcomp.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B89C6"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Разрешите доступ к геолокации для отслеживания маршрута",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Разрешите доступ к камере для фото документов",
          "microphonePermission": false
        }
      ],
      "@rnmapbox/maps",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "apiUrl": "http://localhost:3001",
      "googleWebClientId": "",
      "router": {},
      "eas": {
        "projectId": "9a17d768-28b4-482a-9444-60bd9d95f05b"
      }
    },
    "owner": "pontipilat"
  }
}
